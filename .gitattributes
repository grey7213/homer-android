tools/server/homer_chat_storage.py text eol=lf
tools/server/homer_archive_storage.py text eol=lf
server-patches/chat-storage-r354-v2/homer_chat_storage.py text eol=lf
server-patches/archive-r361/homer_archive_storage.py text eol=lf
server-patches/creator-revenue-r366/*.py text eol=lf
server-patches/memory-cloud-r366/*.py text eol=lf
