@@ -0,0 +1,53 @@
+// Data-only resource exports. Android must use the user-selected document path;
+// Blob downloads are not handled by WebView's network DownloadListener.
+export const RESOURCE_EXPORT_LIMIT = 8 * 1024 * 1024;
+
+export function resourceExportPayload(name, value) {
+    const html = typeof value === 'string';
+    const content = html ? value : JSON.stringify(value, null, 2);
+    if (!content || new TextEncoder().encode(content).length > RESOURCE_EXPORT_LIMIT) {
+        throw Error('导出内容为空或超过 8 MB，请检查资源。');
+    }
+    const stem = String(name || '资源').replace(/[\\/:*?"<>|\u0000-\u001f\u007f]/g, '_').replace(/^[.\s]+|[.\s]+$/g, '').slice(0, 100) || '资源';
+    return { filename: stem + (html ? '.html' : '.json'), mime: html ? 'text/html' : 'application/json', content };
+}
+
+export function exportResource(payload, { native = globalThis.HomerNative, window = globalThis.window, document = globalThis.document } = {}) {
+    if (native) {
+        if (typeof native.exportWorkshopResource !== 'function') throw Error('当前安装包不支持保存资源文件，请更新软件后再导出。');
+        const requestId = globalThis.crypto?.randomUUID?.() || `resource-${Date.now()}-${Math.random().toString(16).slice(2)}`;
+        return new Promise((resolve, reject) => {
+            const finish = event => {
+                if (event.detail?.requestId !== requestId) return;
+                window.removeEventListener('homer-resource-export-result', finish);
+                window.removeEventListener('pagehide', cancelled);
+                if (event.detail.state === 'saved') resolve({ saved: true, filename: payload.filename });
+                else if (event.detail.state === 'cancelled') resolve({ saved: false });
+                else reject(Error(event.detail.message || '文件没有保存，请重试。'));
+            };
+            const cancelled = () => {
+                window.removeEventListener('homer-resource-export-result', finish);
+                window.removeEventListener('pagehide', cancelled);
+                resolve({ saved: false });
+            };
+            window.addEventListener('homer-resource-export-result', finish);
+            window.addEventListener('pagehide', cancelled, { once: true });
+            try {
+                const message = JSON.stringify({ ...payload, requestId });
+                if (message.length > RESOURCE_EXPORT_LIMIT * 2 + 16384) throw Error('导出文本编码后过大，请缩小内容。');
+                native.exportWorkshopResource(message);
+            }
+            catch (error) {
+                window.removeEventListener('homer-resource-export-result', finish);
+                window.removeEventListener('pagehide', cancelled);
+                reject(error);
+            }
+        });
+    }
+    const blob = new Blob([payload.content], { type: payload.mime });
+    const href = URL.createObjectURL(blob), link = document.createElement('a');
+    link.href = href; link.download = payload.filename; document.body.append(link);
+    link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(href), 30000);
+    // Browsers provide no reliable acknowledgement that the user saved a Blob.
+    return Promise.resolve({ initiated: true });
+}
