@@ -0,0 +1,30 @@
+// Presentation only. Privileged commands are separately rechecked by the live
+// runtime and server; a URL, cached profile or document class is not authority.
+export function authorizedAdminHostScope({ requested, ready, state, owner, appId, conversationId }) {
+  return requested === true && ready === true && state?.admin_preview === true
+    && state.admin_authorized === true && typeof owner === 'string' && owner.length > 0
+    && String(state.owner_id || '') === owner
+    && typeof appId === 'string' && appId.length > 0 && String(state.app_id || '') === appId
+    && typeof conversationId === 'string' && conversationId.length > 0
+    && String(state.conversation_id || '') === conversationId;
+}
+
+export function syncAdminHostSettings(root, scope) {
+  if (!root) return false;
+  const allowed = authorizedAdminHostScope(scope);
+  root.dataset.adminWorkspace = allowed ? 'verified' : '';
+  for (const node of root.querySelectorAll('[data-admin-preview-only]')) {
+    node.hidden = !allowed;
+    node.style.display = allowed ? '' : 'none';
+    if (node.tagName === 'BUTTON') node.disabled = !allowed || scope.state.generating === true;
+  }
+  for (const node of root.querySelectorAll('[data-normal-conversation-only]')) {
+    node.hidden = allowed;
+    node.style.display = allowed ? 'none' : '';
+  }
+  const note = root.querySelector('.homer-control-footnote,.preview-privacy-note');
+  if (note) note.textContent = allowed
+    ? '管理员会话工作区。编辑后点“应用到本次会话”，从下一轮生效；保存全局配置需单独确认。'
+    : '角色卡世界书正文受创作者保护。这里只提供创作者允许开放的预设开关。';
+  return allowed;
+}
