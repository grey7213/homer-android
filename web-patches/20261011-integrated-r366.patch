--- /dev/null
+++ b/frontend/assets/js/conversation-history-merge.mjs
@@ -0,0 +1,19 @@
+// A partial/empty cloud list is not a deletion instruction. Explicit owner-
+// scoped tombstones are applied by callers after merging phone-owned metadata.
+export function mergeConversationHistory(local, remote) {
+  const rows = new Map();
+  for (const item of [...(Array.isArray(local) ? local : []), ...(Array.isArray(remote) ? remote : [])]) {
+    const id = String(item?.id || item?.conversation_id || '').trim();
+    if (!id) continue;
+    const previous = rows.get(id);
+    if (!previous) { rows.set(id, { ...item, id }); continue; }
+    const recent = Number(item.updated_at || 0) >= Number(previous.updated_at || 0) ? item : previous;
+    const older = recent === item ? previous : item;
+    rows.set(id, { ...older, ...recent, id,
+      last_message: recent.last_message || older.last_message || '',
+      app_name: recent.app_name || older.app_name || recent.title || older.title || '',
+      app_icon: recent.app_icon || older.app_icon || '',
+    });
+  }
+  return [...rows.values()].sort((a, b) => Number(b.updated_at || 0) - Number(a.updated_at || 0));
+}
diff --git a/frontend/assets/js/conversation-snapshot-policy.mjs b/frontend/assets/js/conversation-snapshot-policy.mjs
