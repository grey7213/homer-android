+// Durable explicit deletion only. Never retry generation, payment or ordinary POSTs.
+import { createChatOutbox } from '/scripts/homer-chat-outbox.mjs';
+import { createLocalSessionStore } from '/scripts/homer-local-session.mjs';
+import { apiText } from './api-transport.js';
+import { getCachedUser, getToken, isLoggedIn } from './api.js?v=20260917-r8';
+
+const outbox = createChatOutbox(), sessions = createLocalSessionStore();
+const markers = new Map();
+const reads = new Map();
+const published = new Map();
+let replay = null, started = false, authEpoch = 0;
+const requests = new Set();
+const ownerNow = () => isLoggedIn() ? String(getCachedUser()?.id || getCachedUser()?.user_id || '') : '';
+const eventName = 'homer:conversation-deletions';
+const mirrorKey = owner => `homer.conversation-deletions.v1:${encodeURIComponent(owner)}`;
+function publish(owner, rows) {
+    markers.set(owner, rows);
+    // A small display fence, not the authoritative deletion journal. The IDB
+    // transaction commits first; a failed localStorage write cannot undo it.
+    try { localStorage.setItem(mirrorKey(owner), JSON.stringify(rows.map(row => row.conversation_id))); } catch {}
+    const fingerprint = JSON.stringify(rows.map(row => [row.conversation_id, row.state, row.errorCode || '']));
