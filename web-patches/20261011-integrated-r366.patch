diff --git a/frontend/app/assets/js/comment-draft.mjs b/frontend/app/assets/js/comment-draft.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..2deb5619fa7060c3a585b0da0462ea2293276f33
--- /dev/null
+++ b/frontend/app/assets/js/comment-draft.mjs
@@ -0,0 +1,27 @@
+import { readPageCache, writePageCache, clearPageCache } from './page-cache.js';
+
+// A reply belongs to one account, one post, and one environment. It is not the
+// composer draft and must not leak into another post or the debug-only sandbox.
+export const commentDraftKey = (postId, local = false) => {
+    const id = String(postId); let forward = 2166136261, backward = 2166136261;
+    for (let i = 0; i < id.length; i++) {
+        forward = Math.imul(forward ^ id.charCodeAt(i), 16777619);
+        backward = Math.imul(backward ^ id.charCodeAt(id.length - 1 - i), 16777619);
+    }
+    return `${local ? 'local-acceptance-' : ''}social-comment.${(forward >>> 0).toString(16)}-${(backward >>> 0).toString(16)}-${id.length}`;
+};
+export function readCommentDraft(postId, user, local = false) {
+    if (!postId || !user?.id) return null;
+    const saved = readPageCache(commentDraftKey(postId, local), user, { maxAgeMs: 365 * 86400000 });
+    return saved?.postId === String(postId) ? saved.draft || null : null;
+}
+export function writeCommentDraft(postId, user, draft, local = false) {
+    if (!postId || !user?.id) return false;
+    if (!String(draft.content || '').trim() && !draft.images?.length) {
+        clearPageCache(commentDraftKey(postId, local), user); return true;
+    }
+    return writePageCache(commentDraftKey(postId, local), user, { postId: String(postId), draft });
+}
+export function clearCommentDraft(postId, user, local = false) {
+    if (postId && user?.id) clearPageCache(commentDraftKey(postId, local), user);
+}
