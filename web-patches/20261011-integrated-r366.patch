+                    await outbox.updateDeletion(owner, id, { state: blocked ? 'blocked' : 'pending', attempts,
+                        errorCode: status ? `HTTP-${status}` : error.reason === 'timeout' ? 'TIMEOUT' : 'NETWORK',
+                        nextAttemptAt: Date.now() + Math.min(300000, 15000 * 2 ** Math.min(attempts, 5)) });
