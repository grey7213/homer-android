+    const changeOwner = () => { ++authEpoch; observedOwner = ownerNow(); for (const request of requests) request.abort(); };
+    window.addEventListener('homer-account-cleared', changeOwner);
+    window.addEventListener('storage', event => {
+        if (!event.key || (['ai_xingyue_user', 'ai_xingyue_logged_in'].includes(event.key) && ownerNow() !== observedOwner)) changeOwner();
+        if (event.key?.startsWith('homer.conversation-deletions.v1:')) {
+            const owner = ownerNow();
+            if (owner) void refreshConversationDeletions(owner).then(() => window.dispatchEvent(new CustomEvent(eventName, { detail: { owner } })));
+        }
+    });
+    setInterval(() => { if (!document.hidden) void flushConversationDeletions(); }, 30000);
+    void flushConversationDeletions();
+}
diff --git a/frontend/assets/js/conversation-history-merge.mjs b/frontend/assets/js/conversation-history-merge.mjs
