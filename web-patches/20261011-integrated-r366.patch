+                    try { ({ response, text } = await apiText(`/console/api/web/conversations/${encodeURIComponent(id)}/delete`, {
+                        method: 'POST', credentials: 'include', headers: { Accept: 'application/json', 'Content-Type': 'application/json',
+                            ...(token ? { Authorization: `Bearer ${token}` } : {}) }, body: '{}', signal: controller.signal,
+                    }, { timeoutMs: 8000 })); } finally { requests.delete(controller); }
