@@ -0,0 +1,32 @@
+export function creatorRevenueRate(payload, expected) {
+  const data = payload?.data ?? payload;
+  const rate = data?.rate_bps;
+  if (!Number.isInteger(rate) || rate < 0 || rate > 10000
+      || (expected !== undefined && rate !== expected)) {
+    throw new Error(expected === undefined ? '收益配置服务返回无效比例' : '服务器未确认所选收益比例，未显示保存成功');
+  }
+  return rate;
+}
+
+export function creatorRevenuePercent(raw) {
+  const value = String(raw).trim();
+  if (!/^\d{1,3}(\.\d{1,2})?$/.test(value)) throw new Error('请输入 0–100 的百分比，最多两位小数');
+  const [whole, fraction = ''] = value.split('.');
+  const rate = Number(whole) * 100 + Number(fraction.padEnd(2, '0'));
+  if (rate > 10000) throw new Error('请输入 0–100 的百分比，最多两位小数');
+  return rate;
+}
+
+export function creatorEarnings(payload) {
+  const data = payload?.data ?? payload;
+  const points = value => Number.isSafeInteger(value) && value >= 0;
+  if (data?.unit !== '积分' || !points(data.creator_points) || !Array.isArray(data.cards)
+      || !data.cards.every(card => typeof card?.id === 'string' && card.id && points(card.points))
+      || (data.invite_points !== null && !points(data.invite_points))) {
+    throw new Error('收益服务返回无效数据，请刷新或联系管理员');
+  }
+  const total = data.cards.reduce((sum, card) => sum + card.points, 0);
+  if (new Set(data.cards.map(card => card.id)).size !== data.cards.length
+      || !Number.isSafeInteger(total) || total !== data.creator_points) throw new Error('角色卡收益与总额不一致，请刷新');
+  return data;
+}
