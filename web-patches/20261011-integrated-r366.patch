@@ -0,0 +1,63 @@
+// Private conversation memories travel with the existing runtime-state outbox.
+// No provider calls, credentials, creator lorebooks or global plugin settings.
+import { encodedBytesSha256 } from './homer-content-digest.mjs';
+
+export const MEMORY_VARIABLE = 'homer_memory_book';
+export const MEMORY_VARIABLE_LIMIT = 512000;
+export const MEMORY_ZERO_VERSION = '00000000000000000000000000000000';
+const hex = value => typeof value === 'string' && /^[a-f0-9]{32}$/.test(value);
+const object = value => value && typeof value === 'object' && !Array.isArray(value);
+const clone = value => JSON.parse(JSON.stringify(value));
+export function memoryScope(scope) {
+    const parts = typeof scope === 'string' ? JSON.parse(scope) : scope;
+    if (!Array.isArray(parts) || parts.length !== 3 || parts.some(v => typeof v !== 'string' || !v.trim() || v.length > 160))
+        throw new TypeError('Invalid private memory scope');
+    return JSON.stringify(parts);
+}
+export function memoryEnvelope(envelope, scope) {
+    if (!object(envelope) || envelope.schema_version !== 1 || memoryScope(envelope.scope) !== memoryScope(scope)
+        || typeof envelope.body !== 'string' || !/^[a-f0-9]{64}$/.test(envelope.digest || '') || !hex(envelope.change_id))
+        throw new TypeError('Private memory identity or version is invalid');
+    const book = JSON.parse(envelope.body);
+    if (!object(book) || book.homerMemory?.version !== 1 || book.homerMemory.scope !== memoryScope(scope) || !object(book.entries))
+        throw new TypeError('Private memory book identity is invalid');
+    for (const entry of Object.values(book.entries)) if (!object(entry)) throw new TypeError('Invalid private memory entry');
+    return book;
+}
+export async function verifiedMemoryBook(envelope, scope) {
+    const book = memoryEnvelope(envelope, scope);
+    if (await encodedBytesSha256(new TextEncoder().encode(envelope.body)) !== envelope.digest)
+        throw new TypeError('Private memory snapshot is incomplete');
+    return clone(book);
+}
+export async function captureMemoryBook(scope, book, previous) {
+    const key = memoryScope(scope);
+    if (!object(book) || book.homerMemory?.version !== 1 || book.homerMemory.scope !== key || !object(book.entries))
+        throw new TypeError('Cannot back up a creator or differently scoped lorebook');
+    const body = JSON.stringify({ entries: book.entries, homerMemory: { version: 1, scope: key } });
+    const digest = await encodedBytesSha256(new TextEncoder().encode(body));
+    if (previous && previous.body === body) { memoryEnvelope(previous, key); return clone(previous); }
+    const bytes = new Uint8Array(16);
+    if (!globalThis.crypto?.getRandomValues) throw new Error('无法安全准备记忆存档，请重试。');
+    globalThis.crypto.getRandomValues(bytes);
+    return { schema_version: 1, scope: JSON.parse(key), body, digest,
+        change_id: [...bytes].map(v => v.toString(16).padStart(2, '0')).join('') };
