+// Copyright (C) 2026 Homer contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+// One real reusable view for the active conversation, not a second data cache.
+export function createConversationMemoryView({ capture, current, build, release }) {
+    let entry = null, epoch = 0;
+    const valid = row => row && row.epoch === epoch && current(row.scope);
+    function invalidate() {
+        const old = entry;
+        entry = null; epoch++;
+        if (old?.view) release(old.view, { stale: true });
+    }
+    function prepare() {
+        if (valid(entry)) return entry.work;
+        invalidate();
+        const scope = capture();
+        if (!scope) return Promise.resolve(null);
+        const row = entry = { scope, epoch, view: null, work: null };
+        row.work = Promise.resolve().then(() => build(scope, () => valid(row))).then(view => {
+            if (!valid(row)) { if (view) release(view, { stale: true }); return null; }
+            row.view = view;
+            return view;
+        }).catch(error => {
+            if (entry === row) entry = null;
+            throw error;
+        });
+        return row.work;
+    }
+    async function open(options = {}) {
+        if (options.signal?.aborted) return;
+        const view = await prepare(), row = entry;
+        if (!view || row?.view !== view || !valid(row) || options.signal?.aborted) return;
+        return view.open(options);
+    }
+    return { prepare, open, invalidate };
+}
