+{"version":3,"sources":["homerConversationStore.js","homerConversationRuntime.js","constants.js","sceneManager.js","userFiles.js","summaryPromptManager.js","utils.js","chatcompile.js","node_modules/lex/lexer.js","node_modules/string.fromcodepoint/fromcodepoint.js","node_modules/unescape-js/dist/index.js","node_modules/utf8/utf8.js","node_modules/dirty-json/lexer.js","node_modules/dirty-json/parser.js","node_modules/dirty-json/dirty-json.js","sidePromptMacros.js","sidePromptsManager.js","index.js","stmemory.js","contextSettingsManager.js","addlore.js","i18nHelpers.js","autocreate.js","homerMemoryAccess.js","autosummary.js","lorebookValidation.js","profileManager.js","templates.js","confirmationPopup.js","sidePrompts.js","stmbJobs.js","sidePromptSetDefaults.js","clipManager.js","sidePromptsPopup.js","templatesSidePrompts.js","contextSettingsPopup.js","arcanalysis.js","templatesArcPrompts.js","arcAnalysisPromptManager.js","summaryTiers.js","memoryTierMacros.js","templatesSummaryPrompts.js","locales.js","homerMemoryView.js","stloCharacterFilters.js"],"sourcesContent":["// Copyright (C) 2026 Homer contributors\n// SPDX-License-Identifier: AGPL-3.0-only\n// A memory book is private conversation data, not the creator's world book.\nexport class HomerMemoryScopeChangedError extends Error {\n    constructor(message = '账号或对话已切换，请重新打开当前对话的长记忆。') {\n        super(message); this.name = 'HomerMemoryScopeChangedError'; this.code = 'HOMER_MEMORY_SCOPE_CHANGED';\n    }\n}\nexport function createHomerConversationStore({ capture, current, digest, read, save, writeLane }) {\n    const names = new Map(), flights = new Map();\n    const requireScope = scope => {\n        if (!scope || !current(scope)) throw new HomerMemoryScopeChangedError();\n        return scope;\n    };\n    async function nameFor(scope) {\n        requireScope(scope);\n        let work = names.get(scope.key);\n        if (!work) {\n            work = Promise.resolve(digest(scope.key)).then(hash => {\n                if (!/^[a-f0-9]{64}$/i.test(hash)) throw new Error('无法准备当前对话的记忆存储，请重试。');\n                return 'homer-memory-' + hash.toLowerCase();\n            });\n            names.set(scope.key, work);\n            if (names.size > 16) names.delete(names.keys().next().value);\n            work.catch(() => { if (names.get(scope.key) === work) names.delete(scope.key); });\n        }\n        const name = await work;\n        requireScope(scope);\n        return name;\n    }\n    async function load(scope, name) {\n        requireScope(scope);\n        const data = await read(scope, name);\n        requireScope(scope);\n        if (data == null) return null;\n        if (data.homerMemory?.version !== 1 || data.homerMemory.scope !== scope.key || !data.entries || Array.isArray(data.entries)) {\n            throw new Error('当前对话的记忆存储身份不一致，已停止读写；不会使用角色设定或其他对话的记忆。');\n        }\n        return structuredClone(data);\n    }\n    async function resolve({ create = false } = {}) {\n        const scope = requireScope(capture()), name = await nameFor(scope);\n        let data = await load(scope, name);\n        if (data || !create) return { scope, name, data };\n        const key = JSON.stringify([scope.key, scope.epoch]);\n        let work = flights.get(key);\n        if (!work) {\n            work = writeLane([name], async () => {\n                requireScope(scope);\n                const existing = await load(scope, name);\n                if (existing) return existing;\n                const fresh = { entries: {}, homerMemory: { version: 1, scope: scope.key } };\n                requireScope(scope);\n                await save(scope, name, fresh);\n                requireScope(scope);\n                return fresh;\n            }).finally(() => { if (flights.get(key) === work) flights.delete(key); });\n            flights.set(key, work);\n        }\n        data = await work;\n        requireScope(scope);\n        return { scope, name, data: structuredClone(data) };\n    }\n    return { read: () => resolve(), ensure: () => resolve({ create: true }), assertCurrent: requireScope };\n}\n","// Copyright (C) 2026 Homer contributors\n// SPDX-License-Identifier: AGPL-3.0-only\nimport { getContext } from '../../../extensions.js';\nimport { saveWorldInfo, world_names, worldInfoCache } from '../../../world-info.js';\nimport { createLocalRuntimeStore } from '../../../homer-local-runtime.mjs';\nimport { encodedBytesSha256 } from '../../../homer-content-digest.mjs';\nimport { createChatOutbox } from '../../../homer-chat-outbox.mjs';\nimport { MEMORY_VARIABLE, captureMemoryBook, verifiedMemoryBook } from '../../../homer-memory-sync.mjs';\nimport { createHomerConversationStore, HomerMemoryScopeChangedError } from './homerConversationStore.js';\n\nlet epoch = 0, activeName = null, activeScope = null;\nconst local = createLocalRuntimeStore();\nconst outbox = createChatOutbox();\nexport const isHomerMemoryRuntime = () => !!globalThis.document?.body?.classList.contains('homer-runtime');\nexport function captureHomerMemoryScope() {\n    if (!isHomerMemoryRuntime()) return null;\n    const context = getContext(), binding = context?.chatMetadata?.homer_bridge;\n    let user;\n    try { user = JSON.parse(localStorage.getItem('ai_xingyue_user') || 'null'); } catch { return null; }\n    const owner = String(user?.id || user?.user_id || '');\n    if (!owner || localStorage.getItem('ai_xingyue_logged_in') !== '1' || !binding?.app_id || !binding?.conversation_id) return null;\n    return { owner, key: JSON.stringify([owner, String(binding.app_id), String(binding.conversation_id)]), epoch, metadata: context.chatMetadata };\n}\nfunction current(scope) {\n    const now = captureHomerMemoryScope();\n    return !!scope && !!now && now.key === scope.key && now.epoch === scope.epoch && now.metadata === scope.metadata;\n}\nasync function canonicalBook(scope, name) {\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    // The bridge's already-loaded runtime state is staged until the REAL chat\n    // metadata matches. No extra network read on opening the memory panel.\n    await globalThis.HomerMemoryStorage?.restore?.(scope);\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    const committed = await outbox.read(scope.key, 'extension-settings');\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    const envelope = committed?.payload?.variables?.[MEMORY_VARIABLE];\n    if (!envelope) return (await local.read(scope.owner, 'world', name))?.data ?? null;\n    const data = await verifiedMemoryBook(envelope, scope.key);\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    const projection = await local.read(scope.owner, 'world', name);\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    if (JSON.stringify(projection?.data) !== JSON.stringify(data)) {\n        await local.update(scope.owner, 'world', name, () => {\n            if (!current(scope)) throw new HomerMemoryScopeChangedError();\n            return { data, localMutation: true };\n        });\n    }\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    worldInfoCache.set(name, data);\n    return data;\n}\nasync function commitBook(scope, data) {\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    const previous = await outbox.read(scope.key, 'extension-settings');\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    const envelope = await captureMemoryBook(scope.key, data, previous?.payload?.variables?.[MEMORY_VARIABLE]);\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    if (globalThis.HomerMemoryStorage?.commit) await globalThis.HomerMemoryStorage.commit(scope, envelope);\n    else {\n        // A standalone isolated engine still commits to the same real outbox.\n        // When the product bridge mounts, its ordinary pending replay uploads\n        // this exact namespace; no alternate endpoint or fake ACK exists.\n        const [, app_id, conversation_id] = JSON.parse(scope.key);\n        const payload = previous?.payload || { app_id, conversation_id, extension_settings: {}, variables: {} };\n        await outbox.prepareMemory({ scope: scope.key, body: JSON.stringify(payload) }, envelope, () => current(scope));\n    }\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    globalThis.document?.dispatchEvent(new CustomEvent('homer-memory-backup', { detail: { scope: scope.key, state: 'pending' } }));\n}\n// Intercept the actual private world write, including upstream summary/tier/\n// editor writes. A WORLDINFO_UPDATED listener cannot fail this save because\n// the shipping event emitter catches listener exceptions. Only marked private\n// books are intercepted; all creator/legacy worlds retain their original path.\nconst WRITE_INSTALL = Symbol.for('homer.memoryWrite.v1');\nfunction installPrivateMemoryWrite() {\n    if (typeof globalThis.fetch !== 'function' || globalThis[WRITE_INSTALL]?.wrapper === globalThis.fetch) return;\n    const next = globalThis.fetch.bind(globalThis);\n    const wrapper = async function privateMemoryWrite(input, init) {\n        // Other extensions may wrap fetch after initialization. Reinstall at\n        // the real memory access boundary; retired wrappers in that chain must\n        // pass through, never commit the same save twice.\n        if (globalThis[WRITE_INSTALL]?.wrapper !== wrapper) return next(input, init);\n        const url = new URL(input instanceof Request ? input.url : String(input), location.href);\n        const method = String(init?.method || (input instanceof Request ? input.method : 'GET')).toUpperCase();\n        if (!isHomerMemoryRuntime() || url.origin !== location.origin || method !== 'POST'\n            || !/\\/api\\/worldinfo\\/(?:edit|delete)$/.test(url.pathname)) return next(input, init);\n        const request = new Request(input instanceof Request ? input : url, init);\n        const payload = await request.clone().json();\n        if (!String(payload.name || '').startsWith('homer-memory-')) return next(input, init);\n        const scope = captureHomerMemoryScope();\n        if (!current(scope)) throw new HomerMemoryScopeChangedError();\n        const name = 'homer-memory-' + await encodedBytesSha256(new TextEncoder().encode(scope.key));\n        if (!current(scope) || name !== payload.name) throw new HomerMemoryScopeChangedError();\n        const data = url.pathname.endsWith('/delete')\n            ? { entries: {}, homerMemory: { version: 1, scope: scope.key } } : payload.data;\n        await commitBook(scope, data);\n        // Outbox is now authoritative. A projection failure is visible; the\n        // next open/injection repairs it from the durable committed snapshot.\n        const response = await next(input, init);\n        if (!current(scope)) throw new HomerMemoryScopeChangedError();\n        return response;\n    };\n    globalThis.fetch = wrapper;\n    globalThis[WRITE_INSTALL] = { wrapper };\n}\ninstallPrivateMemoryWrite();\nconst store = createHomerConversationStore({\n    capture: captureHomerMemoryScope, current,\n    // Same exact UTF-8/SHA-256 on HTTPS, LAN HTTP and older WebViews. The\n    // shared helper retains its licensed offline fallback when SubtleCrypto\n    // is absent/refuses a digest, without changing persisted book names.\n    digest: key => encodedBytesSha256(new TextEncoder().encode(key)),\n    // Read only this owner-scoped durable local record. A missing book is not\n    // an excuse to fetch/select a creator world book or await remote bootstrap.\n    read: canonicalBook,\n    save: async (scope, name, data) => {\n        store.assertCurrent(scope);\n        installPrivateMemoryWrite();\n        await saveWorldInfo(name, data, true);\n        store.assertCurrent(scope);\n        if (!world_names.includes(name)) world_names.push(name);\n    },\n    writeLane: async (_names, task) => task(),\n});\nexport function homerMemoryBookName() { return current(activeScope) ? activeName : null; }\nexport async function resolveHomerMemoryBook({ create = false } = {}) {\n    installPrivateMemoryWrite();\n    const result = await (create ? store.ensure() : store.read());\n    store.assertCurrent(result.scope);\n    activeScope = result.scope; activeName = result.data ? result.name : null;\n    if (activeName && !world_names.includes(activeName)) world_names.push(activeName);\n    return { valid: !!result.data, data: result.data, name: result.name, homerScope: result.scope };\n}\nexport function assertHomerMemoryCurrent(scope) { if (scope) store.assertCurrent(scope); }\nexport async function homerMemoryBackupStatus() {\n    const scope = captureHomerMemoryScope();\n    if (!scope || !current(scope)) return { state: 'unavailable' };\n    const row = await outbox.read(scope.key, 'extension-settings');\n    if (!current(scope)) throw new HomerMemoryScopeChangedError();\n    return { state: !row?.payload?.variables?.[MEMORY_VARIABLE] ? 'empty'\n        : row.pending || !row.memoryVersion ? 'pending' : 'synced' };\n}\n// Queue payloads are structured-cloned. Serialize the identity, not the live\n// metadata reference; then capture a live fenced scope before the job starts.\nexport function assertHomerMemoryIdentity(identity) {\n    if (!isHomerMemoryRuntime()) return null;\n    const scope = captureHomerMemoryScope();\n    if (!identity || !scope || identity.key !== scope.key || identity.epoch !== scope.epoch) {\n        throw new HomerMemoryScopeChangedError('账号或对话已切换，请在当前对话重新发起记忆整理。');\n    }\n    return store.assertCurrent(scope);\n}\nexport async function readHomerMemoryForInjection(chatLore) {\n    if (!isHomerMemoryRuntime()) return;\n    const origin = captureHomerMemoryScope();\n    // Upstream also scans while opening its editor/starting a dry run, before\n    // the application has bound a real chat. Never select any book in that phase.\n    if (!origin) return;\n    let result;\n    