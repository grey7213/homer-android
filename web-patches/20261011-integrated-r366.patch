diff --git a/frontend/assets/js/color-control.mjs b/frontend/assets/js/color-control.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..deea7e6c5c78d177115bca42d08ee53b04c15236
--- /dev/null
+++ b/frontend/assets/js/color-control.mjs
@@ -0,0 +1,44 @@
+// Inline, keyboard-accessible color editing. No platform color-picker dialog.
+let nextId = 0;
+export function colorChannels(value) {
+    return /^#[\da-f]{6}$/i.test(value || '') ? value.slice(1).match(/../g).map(v => parseInt(v, 16)) : null;
+}
+export function channelsColor(channels) {
+    return '#' + channels.map(v => Math.max(0, Math.min(255, Math.round(Number(v) || 0))).toString(16).padStart(2, '0')).join('');
+}
+export function colorControl(label, initial, onColor) {
+    const make = (tag, text) => { const element = document.createElement(tag); if (text) element.textContent = text; return element; };
+    const root = make('div'); root.className = 'homer-color-control';
+    const input = make('input'); input.type = 'text'; input.value = initial;
+    input.maxLength = 7; input.spellcheck = false; input.autocomplete = 'off'; input.setAttribute('aria-label', label);
+    const id = `homer-color-${++nextId}`;
+    const error = make('p'); error.id = id + '-error'; error.className = 'homer-color-error'; error.setAttribute('role', 'status');
+    input.setAttribute('aria-describedby', error.id);
+    const toggle = make('button', '调色'); toggle.type = 'button'; toggle.setAttribute('aria-label', `自定义${label}颜色`);
+    const chip = make('span'); chip.className = 'homer-color-chip'; chip.setAttribute('aria-hidden', 'true');
+    toggle.prepend(chip);
+    const panel = make('div'); panel.className = 'homer-color-channels'; panel.hidden = true; panel.id = id;
+    toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-controls', id);
+    const sliders = [], outputs = [];
+    let value = initial;
+    const control = { root, input, valid: true, setValue(hex) {
+        const channels = colorChannels(hex); if (!channels) return;
+        value = hex.toLowerCase(); input.value = value; chip.style.background = value;
+        channels.forEach((v, i) => { sliders[i].value = String(v); outputs[i].textContent = String(v); });
+        input.removeAttribute('aria-invalid'); error.textContent = ''; control.valid = true;
+    }};
+    for (const [i, name] of ['红', '绿', '蓝'].entries()) {
+        const row = make('label', name), slider = make('input'), output = make('output');
+        slider.type = 'range'; slider.min = '0'; slider.max = '255'; slider.step = '1'; slider.setAttribute('aria-label', `${label}${name}色`);
+        slider.addEventListener('input', () => { control.setValue(channelsColor(sliders.map(s => s.value))); onColor(value); });
+        row.append(slider, output); sliders.push(slider); outputs.push(output); panel.append(row);
+    }
+    input.addEventListener('input', () => {
+        const hex = input.value.trim();
+        if (!colorChannels(hex)) { control.valid = false; input.setAttribute('aria-invalid', 'true'); error.textContent = '请输入 # 加六位色号，例如 #29485f。'; return; }
+        control.setValue(hex); onColor(value);
+    });
+    toggle.addEventListener('click', () => { panel.hidden = !panel.hidden; toggle.setAttribute('aria-expanded', String(!panel.hidden)); });
+    root.append(input, toggle, error, panel); control.setValue(initial);
+    return control;
+}
