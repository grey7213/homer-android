--- /dev/null
+++ b/frontend/assets/js/conversation-snapshot-policy.mjs
@@ -0,0 +1,12 @@
+// Display snapshots are not canonical archives. Initialization/failed reads
+// must never clear a phone-owned preview or persist an empty fallback over it.
+export function acceptsConversationSnapshot(state, { owner, appId, conversationId, adminPreview, hasMessages }) {
+    if (!owner || state?.messages_ready !== true || !Array.isArray(state.messages)) return false;
+    if (String(state.owner_id || '') !== String(owner)
+        || String(state.app_id || '') !== String(appId)
+        || String(state.conversation_id || '') !== String(conversationId)
+        || Boolean(state.admin_preview) !== Boolean(adminPreview)) return false;
+    // A completed explicit removal may legitimately empty a conversation.
+    // A bootstrap/status event cannot make that destructive decision.
+    return !hasMessages || state.messages.length > 0 || state.empty_authorized === true;
+}
