index 0000000000000000000000000000000000000000..a8446a3b59cf4bd24a04c5ce1b03bcbd967c25af
--- /dev/null
+++ b/sillytavern-runtime/public/scripts/homer-generation-intent.mjs
@@ -0,0 +1,17 @@
+// Carry the real sender's intent through the internal custom-provider hop.
+// This is request-local; it must not mutate persistent provider settings or
+// replace signed administrator preview drafts installed by other listeners.
+export function attachHomerGenerationIntent(data, type, parse = JSON.parse) {
+  if (!data || !/(?:^|\n)X-Homer-Module:\s*dialogue-module\s*(?:\n|$)/i.test(String(data.custom_include_headers || ''))) return false;
+  if (!['normal', 'continue', 'regenerate', 'quiet', 'swipe', 'impersonate'].includes(type))
+    throw new Error('[HM-GINTENT] 生成类型无效，请重试');
+  let body = {};
+  try {
+    if (String(data.custom_include_body || '').trim()) body = parse(data.custom_include_body);
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new Error();
+  } catch {
+    throw new Error('[HM-GINTENT] 会话请求配置无效，未发起生成');
+  }
+  data.custom_include_body = JSON.stringify({ ...body, homer_generation_type: type });
+  return true;
+}
