+/** Redact structured credentials, including settings' nested JSON envelope. */
+export function sanitizeRuntimeValue(value, field = '') {
+    if (typeof value === 'string' && field === 'settings') {
+        try { return JSON.stringify(sanitizeRuntimeValue(JSON.parse(value))); }
+        catch { throw new TypeError('Invalid runtime settings'); }
+    }
