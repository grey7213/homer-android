+/* Android bundled UI · shared surfaces, states and touch targets. */
+:root {
+  --ui-bg:#f6f5f8;--ui-panel:#fff;--ui-panel-soft:#f0eef3;--ui-text:#24212c;
+  --ui-muted:#6b6676;--ui-line:#e4e0e9;--ui-accent:#b83262;--ui-accent-soft:#faeaf0;
+  --ui-danger:#b42d44;--ui-success:#197754;--ui-radius:18px;--ui-control:12px;
+  --ui-shadow:0 6px 24px #2b20300a;--ui-float:0 18px 60px #24152b26;
+  --fy-bg:var(--ui-bg);--fy-panel:var(--ui-panel);--fy-panel-2:var(--ui-panel-soft);
+  --fy-text:var(--ui-text);--fy-text-soft:var(--ui-muted);--fy-text-mute:var(--ui-muted);
+  --fy-border:var(--ui-line);--fy-accent:#b83262;--fy-accent-2:#b83262;--fy-accent-soft:var(--ui-accent-soft);
+}
+html[data-theme="dark"],body[data-theme="dark"],body.theme-dark {
+  --ui-bg:#17161c;--ui-panel:#222029;--ui-panel-soft:#2c2934;--ui-text:#f1edf5;
+  --ui-muted:#b8b1c3;--ui-line:#3b3645;--ui-accent:#f48ab0;--ui-accent-soft:#422635;
+  --ui-danger:#ff96a6;--ui-success:#8cd6b7;
+}
+html {scroll-behavior:smooth;color-scheme:light}
+body {font-family:system-ui,-apple-system,"Segoe UI","Microsoft YaHei",sans-serif;color:var(--ui-text);background:var(--ui-bg);line-height:1.6}
+*,*::before,*::after{box-sizing:border-box}
+button,a,summary,[role="button"],label:has(input[type="checkbox"]),label:has(input[type="radio"]){-webkit-tap-highlight-color:transparent;touch-action:manipulation}
+button,summary,[role="button"]{-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
+button,input,textarea,select{font:inherit}
+button{cursor:pointer}
+button:disabled,[aria-disabled="true"]{cursor:not-allowed;opacity:.48;box-shadow:none!important}
+button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--ui-accent);outline-offset:3px}
+button:active:not(:disabled){filter:brightness(.94)}
+input,textarea,select{accent-color:var(--ui-accent)}
+.xy-input,input.xy-input,select.xy-input,textarea.xy-input {min-height:44px;border:1px solid var(--ui-line)!important;border-radius:var(--ui-control)!important;background:var(--ui-panel)!important;color:var(--ui-text)!important;padding:11px 13px;box-shadow:none;font-size:14px;line-height:1.5}
+.xy-input::placeholder{color:var(--ui-muted);opacity:.8}
+.xy-input:focus{outline:2px solid var(--ui-accent);outline-offset:1px}
+.xy-label{font-size:13px!important;font-weight:600;color:var(--ui-muted)!important;margin-bottom:7px}
+.xy-btn,.ui-icon-button,.home-icon-btn,.theme-switch-button{min-height:44px;border-radius:var(--ui-control)!important;font-size:14px;font-weight:600;line-height:1.4;box-shadow:none;transition:background .15s,color .15s}
+.xy-btn-primary{background:var(--ui-accent)!important;color:#fff!important;border:1px solid transparent!important}
+.xy-btn-ghost{background:var(--ui-panel)!important;border:1px solid var(--ui-line)!important;color:var(--ui-text)!important}
+.ui-icon-button{display:inline-flex;align-items:center;justify-content:center;width:44px;flex:none;border:1px solid var(--ui-line);background:var(--ui-panel);color:var(--ui-text);padding:11px}
+.ui-icon-button svg{width:22px;height:22px}
+.xy-glass,.list-panel,.profile-settings,.profile-setting-section,.editor-section{background:var(--ui-panel)!important;color:var(--ui-text);border:1px solid var(--ui-line)!important;border-radius:var(--ui-radius)!important;box-shadow:var(--ui-shadow)!important;backdrop-filter:none!important}
+.xy-stars-bg,.xy-meteor{display:none!important}
+.xy-gradient-text{background:none!important;-webkit-text-fill-color:currentColor!important;color:var(--ui-text)!important}
