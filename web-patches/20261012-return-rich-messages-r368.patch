+// Font-provider CSS is decorative, not a prerequisite for the card's scripts.
+// Rewrite display documents only; the authored message/copyable source is intact.
+const rawText = new Set(['script', 'textarea', 'title', 'xmp', 'iframe', 'noembed', 'noframes', 'plaintext']);
+const fontUrl = value => {
+    try { const u = new URL(value); return u.protocol === 'https:' && !u.username && !u.password
+        && u.hostname === 'fonts.googleapis.com' && (!u.port || u.port === '443')
+        && /^\/css2?$/.test(u.pathname); } catch { return false; }
+};
+const escapeAttr = s => s.replaceAll('&', '&amp;').replaceAll('"', '&quot;');
+const loader = '<script>window.addEventListener("load",function(){document.querySelectorAll("link[data-homer-font-href]").forEach(function(link){var href=link.getAttribute("data-homer-font-href");link.removeAttribute("data-homer-font-href");link.setAttribute("href",href)})},{once:true});</script>';
+
+function deferImports(css, links) {
+    // Comments and ordinary strings are opaque. Only a complete, unqualified
+    // Google Fonts @import is moved; other CSS/import/layer/media semantics stay.
+    const tokens = /\/\*[\s\S]*?\*\/|"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'|@import\s+(?:url\(\s*(?:"([^"\\]*)"|'([^'\\]*)'|([^\s)'";]+))\s*\)|"([^"\\]*)"|'([^'\\]*)')\s*;/gi;
+    return css.replace(tokens, (token, ...captures) => {
+        if (!/^@import\s/i.test(token)) return token;
+        const url = captures.slice(0, 5).find(v => typeof v === 'string');
+        if (!fontUrl(url)) return token;
+        links.push('<link rel="stylesheet" data-homer-font-href="' + escapeAttr(url) + '">');
+        return '/* font stylesheet loads after the card document */';
+    });
+}
+
+export function deferRemoteFontStylesheets(html, enabled = false) {
+    if (!enabled || typeof html !== 'string' || !html.includes('fonts.googleapis.com')
+        || /content-security-policy/i.test(html) || !/<head(?:\s[^>]*)?>/i.test(html)) return html;
+    const tags = /<!--[\s\S]*?-->|<\/?[a-zA-Z][a-zA-Z0-9:-]*(?:[^'"<>]|"[^"]*"|'[^']*')*>/g;
+    let opaque = '', cursor = 0, result = '', changed = false;
+    const links = [];
+    let tag;
+    while ((tag = tags.exec(html))) {
+        const parsed = /^<(\/?)([\w:-]+)/.exec(tag[0]);
+        if (!parsed) continue;
+        const [, closing, rawName] = parsed, name = rawName.toLowerCase();
+        if (opaque) { if (closing && name === opaque) opaque = ''; continue; }
+        if (!closing && rawText.has(name)) { opaque = name; continue; }
+        if (!closing && name === 'style') {
+            const end = /<\/style\s*>/gi; end.lastIndex = tags.lastIndex;
+            const close = end.exec(html); if (!close) continue;
+            const css = html.slice(tags.lastIndex, close.index), rewritten = deferImports(css, links);
+            if (rewritten !== css) { result += html.slice(cursor, tags.lastIndex) + rewritten; cursor = close.index; changed = true; }
+            tags.lastIndex = end.lastIndex; continue;
+        }
+        if (closing || name !== 'link') continue;
+        const attributes = /([^\s="'<>`/]+)(?:\s*=\s*(?:"([^"]*)"|'([^']*)'|([^\s"'=<>`]+)))?/g;
+        attributes.lastIndex = parsed[0].length;
+        const values = new Map(); const duplicates = new Set(); let attr;
+        while ((attr = attributes.exec(tag[0]))) {
+            const key = attr[1].toLowerCase();
+            if (!values.has(key)) values.set(key, { value: attr[2] ?? attr[3] ?? attr[4] ?? '', index: attr.index, name: attr[1] });
+            else duplicates.add(key);
+        }
+        const href = values.get('href');
+        if (!href || duplicates.has('href') || duplicates.has('rel') || !fontUrl(href.value) || values.has('data-homer-font-href')
+            || !values.get('rel')?.value.toLowerCase().split(/\s+/).includes('stylesheet')) continue;
+        const rewritten = tag[0].slice(0, href.index) + 'data-homer-font-href' + tag[0].slice(href.index + href.name.length);
+        result += html.slice(cursor, tag.index) + rewritten; cursor = tags.lastIndex; changed = true;
+    }
+    if (!changed) return html;
+    result += html.slice(cursor);
+    return result.replace(/<head(?:\s[^>]*)?>/i, head => head + loader + links.join(''));
+}
