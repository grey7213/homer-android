+// Homer-owned interaction adapter. No third-party UI implementation is copied.
+// Events inside a message iframe never bubble into the outer #chat listener.
+export const MESSAGE_CONTROL_SELECTOR = 'button,a,input,textarea,select,option,summary,video,audio,canvas,[role="button"],[contenteditable]:not([contenteditable="false"]),[data-homer-native-selection],.mes_buttons,.mes_edit_buttons';
+
+export function isMessageControl(target) {
+    const element = target?.nodeType === 3 ? target.parentElement : target;
+    return Boolean(element?.closest?.(MESSAGE_CONTROL_SELECTOR));
+}
+
+export function createMessagePress({ capture, accepts, open, clearSelection = () => {},
+    setTimer = setTimeout, clearTimer = clearTimeout, now = Date.now, delay = 500, tolerance = 10 } = {}) {
+    let pending = null, timer = null, suppressedUntil = 0;
+    function cancel() { clearTimer(timer); timer = null; pending = null; }
+    function show(ticket, event) {
+        if (!ticket || !accepts(ticket.binding) || isMessageControl(event?.target)) return false;
+        clearSelection();
+        suppressedUntil = now() + 700;
+        open(ticket.binding, { x: ticket.x, y: ticket.y });
+        return true;
+    }
+    return {
+        cancel,
+        down(event) {
+            cancel(); // A second pointer cancels, rather than replacing the first.
+            if (event.isPrimary === false || event.button > 0 || isMessageControl(event.target)) return;
+            const binding = capture();
+            if (!binding || !accepts(binding)) return;
+            const ticket = { binding, pointer: event.pointerId, x: Number(event.clientX), y: Number(event.clientY) };
+            pending = ticket;
+            timer = setTimer(() => { if (pending === ticket) show(ticket); cancel(); }, delay);
+        },
+        move(event) {
+            if (pending && (event.pointerId !== pending.pointer || Math.hypot(
+                Number(event.clientX) - pending.x, Number(event.clientY) - pending.y) > tolerance)) cancel();
+        },
+        context(event) {
+            cancel();
+            if (isMessageControl(event.target)) return;
+            const binding = capture();
+            if (now() < suppressedUntil && accepts(binding)) {
+                event.preventDefault(); event.stopPropagation(); return;
+            }
+            if (show({ binding, x: Number(event.clientX), y: Number(event.clientY) }, event)) {
+                event.preventDefault(); event.stopPropagation();
+            }
+        },
+        click(event) {
+            if (now() < suppressedUntil && accepts(capture()) && !isMessageControl(event.target)) {
+                event.preventDefault(); event.stopImmediatePropagation();
+            }
+        },
+        select(event) { if (!isMessageControl(event.target) && accepts(capture())) event.preventDefault(); },
+    };
+}
+
+// Bind exact iframe/document/message/launch identities. Never trust an index-only
+// postMessage from card code; this same-origin path adds no privileged RPC.
+export function createMessageFrameMenus({ root, capture, accepts, open } = {}) {
+    const records = new Map();
+    let stopped = false;
+    function remove(frame) {
+        const record = records.get(frame);
+        if (!record) return;
+        record.cleanup(); records.delete(frame);
+    }
+    function attach(frame, topFrame = frame, parentRecord = null) {
+        if (stopped || !frame.isConnected || !topFrame.isConnected || !root.contains(topFrame)) return;
+        const existing = records.get(frame);
+        if (existing && existing.valid()) { existing.scan(); return; }
+        remove(frame);
+        const binding = parentRecord?.binding || capture(topFrame);
+        if (!binding) return;
+        const record = { binding, document: null, disposeDocument: () => {}, cleanup: () => {} };
+        record.valid = () => !stopped && frame.isConnected && topFrame.isConnected && root.contains(topFrame)
+            && accepts(binding, topFrame) && (!parentRecord || parentRecord.valid());
+        record.scan = () => {
+            if (!record.valid()) return;
+            let doc;
+            try { doc = frame.contentDocument; } catch { return; }
+            if (!doc?.documentElement) return; // Opaque/external frames retain their normal controls.
+            if (record.document !== doc) {
+                record.disposeDocument(); record.document = doc;
+                const win = doc.defaultView, listeners = [];
+                const validDocument = () => {
+                    try { return record.valid() && frame.contentDocument === doc; } catch { return false; }
+                };
+                const press = createMessagePress({ capture: () => binding, accepts: validDocument,
+                    clearSelection: () => win.getSelection?.()?.removeAllRanges?.(),
+                    open: (_, anchor) => {
+                        const rect = topFrame.getBoundingClientRect();
+                        // Coordinates in nested frames are bounded to the actual message.
+                        open(binding, { x: rect.left + Math.min(rect.width, Math.max(0, anchor.x)),
+                            y: rect.top + Math.min(rect.height, Math.max(0, anchor.y)) });
+                    }, setTimer: win.setTimeout.bind(win), clearTimer: win.clearTimeout.bind(win) });
+                const listen = (target, name, handler, options = true) => {
+                    target.addEventListener(name, handler, options);
+                    listeners.push(() => target.removeEventListener(name, handler, options));
+                };
+                listen(doc, 'pointerdown', press.down);
+                listen(doc, 'pointermove', press.move);
+                for (const name of ['pointerup', 'pointercancel', 'lostpointercapture']) listen(doc, name, press.cancel);
+                listen(doc, 'contextmenu', press.context);
+                listen(doc, 'click', press.click);
+                listen(doc, 'selectstart', press.select);
+                listen(doc, 'scroll', press.cancel);
+                listen(win, 'blur', press.cancel);
+                listen(win, 'pagehide', press.cancel);
+                listen(doc, 'visibilitychange', press.cancel);
+                const style = doc.createElement('style');
+                style.dataset.homerMessageGesture = 'true';
+                style.textContent = 'body{-webkit-touch-callout:none;-webkit-user-select:none;user-select:none}'
+                    + `${MESSAGE_CONTROL_SELECTOR}{-webkit-touch-callout:default;-webkit-user-select:text;user-select:text}`;
+                (doc.head || doc.documentElement).append(style);
+                const observer = new MutationObserver(() => record.scan());
+                observer.observe(doc.documentElement, { childList: true, subtree: true });
+                record.disposeDocument = () => { press.cancel(); observer.disconnect(); listeners.forEach(fn => fn()); style.remove(); };
+            }
+            for (const child of doc.querySelectorAll('iframe')) attach(child, topFrame, record);
+        };
+        const loaded = () => { record.disposeDocument(); record.document = null; record.scan(); };
+        frame.addEventListener('load', loaded);
+        record.cleanup = () => { frame.removeEventListener('load', loaded); record.disposeDocument(); };
+        records.set(frame, record);
+        record.scan();
+    }
+    function refresh() {
+        if (stopped) return;
+        for (const [frame, record] of records) if (!record.valid()) remove(frame);
+        for (const frame of root.querySelectorAll('.mes_text iframe')) attach(frame);
+    }
+    const observer = new MutationObserver(refresh);
+    observer.observe(root, { childList: true, subtree: true });
+    refresh();
+    return { refresh, stop() { stopped = true; observer.disconnect(); for (const frame of records.keys()) remove(frame); } };
+}
