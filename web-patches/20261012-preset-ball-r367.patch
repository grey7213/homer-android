+  const vh = hostWindow.innerHeight;
+  // 面板高度不超过屏幕 90%
+  const clampedH = Math.min(isExpanded.value ? panelSize.h : Math.min(panelSize.h, 420), Math.floor(vh * 0.9));
+  return {
+    left: `${pos.x}px`,
+    top: `${pos.y}px`,
+    width: `${panelSize.w}px`,
