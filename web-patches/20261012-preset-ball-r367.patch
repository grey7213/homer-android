nable': [];\n  'batch-disable': [];\n  'batch-delete': [];\n  'batch-move-to-group': [];\n}>();\n</script>\n\n<style scoped>\n.chaoxi-batch-toolbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 6px 8px;\n  border-bottom: 1px solid rgba(120, 168, 147, 0.1);\n  background: rgba(5, 8, 16, 0.4);\n  flex-shrink: 0;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.chaoxi-batch-left {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.chaoxi-checkbox {\n  width: 16px;\n  height: 16px;\n  accent-color: #78a893;\n  cursor: pointer;\n  flex-shrink: 0;\n}\n\n.chaoxi-batch-count {\n  font-size: 12px;\n  color: #78a893;\n  font-weight: 500;\n}\n\n.chaoxi-batch-total {\n  font-size: 12px;\n  color: rgba(255, 255, 255, 0.35);\n}\n\n.chaoxi-batch-actions {\n  display: flex;\n  gap: 4px;\n  flex-wrap: wrap;\n}\n\n.chaoxi-batch-btn {\n  padding: 3px 10px;\n  border-radius: 4px;\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  background: rgba(255, 255, 255, 0.03);\n  color: rgba(255, 255, 255, 0.5);\n  font-size: 11px;\n  cursor: pointer;\n  transition: all 0.15s;\n  white-space: nowrap;\n}\n\n.chaoxi-batch-on:hover {\n  background: rgba(120, 168, 147, 0.12);\n  color: #78a893;\n  border-color: rgba(120, 168, 147, 0.3);\n}\n\n.chaoxi-batch-off:hover {\n  background: rgba(255, 255, 255, 0.08);\n  color: rgba(255, 255, 255, 0.7);\n}\n\n.chaoxi-batch-group:hover {\n  background: rgba(120, 168, 147, 0.12);\n  color: #78a893;\n  border-color: rgba(120, 168, 147, 0.3);\n}\n\n.chaoxi-batch-delete:hover {\n  background: rgba(248, 113, 113, 0.12);\n  color: #d9796b;\n  border-color: rgba(248, 113, 113, 0.3);\n}\n</style>\n","<template>\n  <div class=\"chaoxi-batch-toolbar\" v-if=\"totalCount > 0\">\n    <div class=\"chaoxi-batch-left\">\n      <input\n        type=\"checkbox\"\n        class=\"chaoxi-checkbox\"\n        :checked=\"allSelected\"\n        :indeterminate=\"someSelected && !allSelected\"\n        @change=\"$emit('toggle-all')\"\n  