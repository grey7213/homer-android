@@ -0,0 +1,27 @@
+// Homer host/API compatibility layer; not upstream source recovery.
+import { inject } from 'vue';
+export const HOST = Symbol('homer-preset-host');
+export function usePresetHost(): any { const host = inject(HOST); if (!host) throw new Error('Missing conversation preset host'); return host; }
+let activeHost: any;
+export function setPresetHost(host: any) { activeHost = host; }
+export interface PromptItem { name: string; displayName: string; enabled: boolean; toggleable: boolean; lockedReason?: string; role: string; hasContent: boolean; content?: string; }
+export interface CustomGroup { id: string; name: string; }
+export const STORAGE_KEY = 'homer-preset-ball-position-v1';
+export const EDGE_GAP = 12, FAB_SIZE = 44, DRAG_THRESHOLD = 4;
+export const DEFAULT_PANEL_W = 560, DEFAULT_PANEL_H = 620, MIN_PANEL_W = 400, MIN_PANEL_H = 300;
+export function readPanelSize() { try { const n = JSON.parse(localStorage.getItem('homer-preset-ball-size-v1') || '{}');
+  return { w: Math.max(400, Math.min(800, Number(n.w) || 560)), h: Math.max(300, Math.min(1000, Number(n.h) || 620)) }; } catch { return { w: 560, h: 620 }; } }
+export function savePanelSize(size: { w: number; h: number }) { try { localStorage.setItem('homer-preset-ball-size-v1', JSON.stringify(size)); } catch {} }
+export function readConfig() { return { groups: [] }; }
+export function getLoadedPresetName() { return activeHost?.state.name || ''; }
+export function getVisiblePrompts(): PromptItem[] { return (activeHost?.state.entries || []).map((entry: any) => ({
+  name: entry.id, displayName: entry.name, enabled: entry.enabled, toggleable: entry.toggleable,
+  lockedReason: entry.lockedReason, role: 'system', hasContent: false,
+})); }
+export function togglePromptEnabled(name: string, old: boolean) { return activeHost.controller.set([{ id: name, enabled: !old }]); }
+export function batchSetEnabled(names: string[], enabled: boolean) { return activeHost.controller.set(names.map(id => ({ id, enabled }))); }
+export function stripEmoji(name: string) { return name; }
+const unavailable = () => { throw new Error('Preset source editing is not available in this conversation module'); };
+export const batchDeletePrompts = unavailable, createPrompt = unavailable, deletePrompt = unavailable,
+  movePrompt = unavailable, movePromptToIndex = unavailable, duplicatePrompt = unavailable,
+  renamePrompt = unavailable, savePromptContent = unavailable;
