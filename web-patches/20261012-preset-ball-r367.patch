index 0000000000000000000000000000000000000000..0ff722e408ff08be7db0540f8e9d8e4778793d5a
--- /dev/null
+++ b/sillytavern-runtime/public/scripts/extensions/homer-preset-ball/src/entry.ts
@@ -0,0 +1,12 @@
+import { createApp, reactive } from 'vue';
+import App from './App.vue';
+import { HOST, setPresetHost } from './types';
+export function mountPresetBall(element: HTMLElement, controller: any) {
+  const state = reactive(controller.snapshot());
+  const host = { state, controller, retry: () => controller.retry() };
+  setPresetHost(host);
+  const unsubscribe = controller.subscribe((next: any) => Object.assign(state, next));
+  const app = createApp(App); app.provide(HOST, host);
+  const view: any = app.mount(element);
+  return { open: () => view.open(), close: () => view.close(), destroy() { unsubscribe(); app.unmount(); setPresetHost(null); } };
+}
