+// Homer data adapter, not recovered upstream implementation. UI source is in src/.
+// Public metadata only; no prompt text, third-party requests or generation replay.
+const clone = value => JSON.parse(JSON.stringify(value));
+const keyPrefix = 'homer:preset-ball:v1:';
+const failure = (code, message) => Object.assign(new Error(`[${code}] ${message}`), { code });
+
+export function publicPresetCatalog(runtime = {}) {
+    const preset = runtime.preset || {};
+    const card = preset.card_prompt;
+    const config = card?.preset_id && card.enabled ? card : preset.current_prompt || preset.prompt || preset.global_prompt || {};
+    const kind = String(config.kind || 'global_prompt');
+    const available = config.enabled !== false && !(kind === 'global_prompt' && runtime.global_preset_enabled === false);
+    const entries = (available && Array.isArray(config.entries) ? config.entries : []).filter(entry =>
+        entry && entry.id && entry.user_toggleable === true && entry.toggleable === true && !entry.locked,
+    ).map(entry => ({
+        id: String(entry.id), name: String(entry.name || entry.id).slice(0, 200),
+        enabled: entry.enabled === true, defaultEnabled: entry.inherited_enabled === true,
+        toggleable: true, lockedReason: '',
+    }));
+    const revision = String(config.revision || config.version || JSON.stringify(entries.map(e => [e.id, e.defaultEnabled])));
+    return { kind, id: String(config.preset_id || ''), revision, name: String(config.name || '当前预设').slice(0, 200), entries };
+}
+
+export function createPresetBallController({ storage, request, current, onApplied = () => {} }) {
+    let active = null, generation = 0, mutationVersion = 0, running = null;
+    const listeners = new Set();
+    let state = { bound: false, scope: '', name: '', entries: [], pending: false, saving: false, status: '', revision: 0 };
+    function notify() { state.revision++; for (const listener of listeners) listener(clone(state)); }
+    function read(key) {
+        const text = storage.getItem(key);
+        if (!text) return { version: 1, changes: {} };
+        try { const data = JSON.parse(text); if (data.version === 1 && data.changes && typeof data.changes === 'object') return data; } catch { /* Fall through to visible, fail-closed recovery. */ }
+        throw failure('HM-P005', '本机预设设置无法读取，请点重试；不会用默认值覆盖原设置');
+    }
+    function write(target, changes) {
+        // Local commit must succeed before an optimistic UI or network request.
+        storage.setItem(target.key, JSON.stringify({ version: 1, changes }));
+    }
+    function valid(target) { return active === target && current(target.scope) && target.generation === generation; }
+    function refresh(target) {
+        if (!valid(target)) return;
+        state.name = target.catalog.name;
+        if (target.storageError) { state.entries = []; state.pending = true; notify(); return; }
+        state.entries = target.catalog.entries.map(entry => ({ ...entry,
+            enabled: Object.hasOwn(target.record.changes, entry.id) ? target.record.changes[entry.id].enabled : entry.enabled }));
+        state.pending = Object.values(target.record.changes).some(change => change.pending);
+        notify();
+    }
+    function reconcilePhoneChoices(target) {
+        if (target.storageError || !valid(target)) return;
+        const changes = clone(target.record.changes);
+        let changed = false;
+        for (const entry of target.catalog.entries) {
+            const saved = Object.hasOwn(changes, entry.id) ? changes[entry.id] : null;
+            if (saved && !saved.pending && saved.enabled !== entry.enabled) {
+                saved.pending = true; saved.stamp++; changed = true;
+            }
+        }
+        if (changed) {
+            write(target, changes); target.record.changes = changes;
+            mutationVersion++;
+            // Reconcile setting writes only. Never block entry or replay generation.
+            void flush(target);
+        }
+    }
+    function bind(scope, runtime) {
+        const catalog = publicPresetCatalog(runtime);
+        const identity = JSON.stringify([scope?.owner, scope?.epoch, scope?.appId, scope?.conversationId, catalog.kind, catalog.id, catalog.revision]);
+        if (active?.identity === identity && current(active.scope)) {
+            active.catalog = catalog;
+            try { reconcilePhoneChoices(active); } catch { active.storageError = true; state.status = '本机保存失败，原设置已保留；请点重试'; }
+            refresh(active); return;
+        }
+        generation++; mutationVersion++;
+        active = null;
+        state = { bound: false, scope: identity, name: catalog.name, entries: [], pending: false, saving: false, status: '', revision: state.revision };
+        if (!scope?.owner || !scope.conversationId || scope.preview || !catalog.id || !current(scope)) { notify(); return; }
+        const durableKey = JSON.stringify([scope.owner, scope.appId, scope.conversationId, catalog.kind, catalog.id, catalog.revision]);
+        const target = { scope, identity, catalog, generation, key: keyPrefix + durableKey, record: { version: 1, changes: {} } };
+        try {
+            target.record = read(target.key);
+            const ids = new Set(catalog.entries.map(e => e.id));
+            target.record.changes = Object.fromEntries(Object.entries(target.record.changes).filter(([id, item]) =>
+                ids.has(id) && item && typeof item.enabled === 'boolean' && Number.isSafeInteger(item.stamp) && item.stamp > 0,
+            ));
+            active = target; state.bound = true; reconcilePhoneChoices(target); refresh(target);
+        } catch {
+            target.storageError = true; active = target; state.bound = true;
