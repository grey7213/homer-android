+</article></template></section>`;
+const feedback=`<div class="c-feedback" x-show="loading&&(!posts.length||(page==='activity'&&activityTab!=='posts')||(page==='profile'&&profileTab!=='posts'))" role="status"><span class="c-spinner"></span>正在读取…</div><div class="c-feedback c-error" x-show="error" role="alert"><p x-text="error"></p><button @click="retry()">重试</button></div>`;
