+export const icon=name=>`<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="${paths[name]||paths.tag}"/></svg>`;
+const tool=(label,name,click)=>`<button type="button" class="c-icon" aria-label="${label}" @click="${click}">${icon(name)}</button>`;
+const header=page=>page==='home'?`<header class="c-header"><nav class="c-home-tabs" aria-label="社区范围"><button @click="setScope('following')" :class="{'is-active':scope==='following'}">关注</button><button @click="setScope('public')" :class="{'is-active':scope==='public'}">推荐</button></nav><div class="c-actions">${tool('搜索社区','search',"go('/app/community-search.html')")}${tool('社区消息','mail',"go('/app/community-messages.html')")}</div></header>`:`<header class="c-header">${tool('返回','back','back()')}<h1 x-text="title"></h1><div class="c-actions">${page==='compose'?'<button class="c-primary" @click="publish()" :disabled="publishing||uploading||muted||!draft.content.trim()" x-text="publishing?\'发布中\':\'发布\'"></button>':page==='post'?tool('帖子操作','more','detail && openActions(detail)'):page==='activity'?tool('写帖子','write','openEditor()'):'<span class="c-header-spacer"></span>'}</div></header>`;
+const feed=`<section class="c-feed" aria-label="社区帖子"><template x-for="post in posts" :key="post.id"><article class="c-post">
+  <header><button class="c-author" @click="openUser(post.user_id)"><span class="c-avatar" x-text="post.author.slice(0,1)"></span><span><strong x-text="post.author"></strong><small x-text="formatTime(post.created_at)"></small></span></button>${tool('更多操作','more','openActions(post)')}</header>
