+const page=pages[location.pathname.split('/').pop()]||'home';
+const titles={home:'社区',search:'搜索',post:'帖子详情',compose:'发布帖子',activity:'我的动态',profile:'作者主页',messages:'社区消息',saved:'我的收藏'};
