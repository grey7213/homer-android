+.community-local-banner{box-sizing:border-box;background:#fff4d9;color:#614314;border:1px solid #d4ab51;border-radius:14px;padding:14px;margin:12px 0;font:14px/1.6 system-ui;clear:both}
+.community-local-banner p{margin:6px 0;color:#614314}.community-local-banner>div{display:flex;gap:8px;flex-wrap:wrap}.community-local-banner button{min-height:44px;padding:8px 12px;border:1px solid #aa7b21;border-radius:10px;background:#fff;color:#614314;font:600 13px system-ui}.community-local-banner button:focus-visible{outline:3px solid #614314;outline-offset:2px}
+body[data-community-local=true] .social-dialog-header,body[data-community-local=true] .community-dialog>header{flex-wrap:wrap}
+body[data-community-local=true] .social-dialog-header::after,body[data-community-local=true] .community-dialog>header::after{content:'本机验收 · 不上传';flex-basis:100%;color:#614314;background:#fff4d9;padding:4px 8px;border-radius:6px;font:12px/1.5 system-ui}
+.community-dialog{box-sizing:border-box;width:min(640px,calc(100vw - 24px));max-height:calc(100dvh - 32px - env(safe-area-inset-top) - env(safe-area-inset-bottom));padding:0;border:1px solid #dce2ee;border-radius:20px;background:#fff;color:#202a3c;box-shadow:0 20px 80px #17243a44;overflow:auto;color-scheme:light}
+.community-dialog::backdrop{background:#0c162b88;backdrop-filter:blur(3px)}
