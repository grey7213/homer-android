+    finally{controllers.delete(controller);}
+  }
+  const wake=()=>{for(const owner of owners)if(isCurrent(owner)===true)void pull(owner);};
+  events?.addEventListener?.('online',wake);events?.addEventListener?.('homer:page-visible',wake);events?.addEventListener?.('homer:app-enter',wake);
+  const wrapped={...store,sync,pull,
+    close(){dead=true;++epoch;for(const timer of timers)clearTimeout(timer);timers.clear();for(const c of controllers)c.abort();
