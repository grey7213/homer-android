+  };
+  for(const method of ['create','command','checkpoint','restore','withdraw','deleteCheckpoint'])wrapped[method]=async(owner,...args)=>{
+    const result=await store[method](owner,...args);const id=method==='create'?result.id:args[0];enqueue(owner,id);return result;
+  };
+  return wrapped;
+}
