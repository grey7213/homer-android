--- /dev/null
+++ b/frontend/app/assets/js/visual-novel-game-sync.mjs
@@ -0,0 +1,131 @@
+// Local commits never wait for a server. Only inert snapshots use this outbox;
+// generation, billing and third-party media are never retried or uploaded here.
+import { createGameStore, validateGameBundle } from './visual-novel-game-store.mjs';
