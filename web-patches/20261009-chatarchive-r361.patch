index 0000000000000000000000000000000000000000..3bfa5555a3abeaad9be73cb916e50d5c7b115a2d
--- /dev/null
+++ b/frontend/app/assets/js/archive-game-ui.mjs
@@ -0,0 +1,101 @@
+// Clean-room presentation derived from the public layout specification, not
+// recovered proprietary UI code. No providers, credentials or game state here.
+import { readableGameReply } from './visual-novel-game-store.mjs';
+import { buildTimeline } from './visual-novel-core.mjs';
+
+const make = (tag, cls = '', text = '') => { const node = document.createElement(tag); node.className = cls; node.textContent = text; return node; };
+const picture = (url, cls, alt = '') => { const img = make('img', cls); img.alt = alt; img.decoding = 'async'; img.referrerPolicy = 'no-referrer';
+  try { const u = new URL(url || '', location.href); if (url && !u.username && !u.password && (u.origin === location.origin || u.protocol === 'https:')) img.src = u.href; } catch { /* No untrusted protocol. */ }
+  if (!img.hasAttribute('src')) img.hidden = true; return img; };
+const button = (label, action, cls = '') => { const node = make('button', cls, label); node.type = 'button';
+  node.addEventListener('click', () => Promise.resolve().then(action).catch(() => {})); return node; };
+
+export function installGameInterface(reader, { session, enterCharacter, enterDate, enterGroup }) {
+  const css = make('link'); css.rel = 'stylesheet'; css.href = '/app/assets/css/archive-game.css?v=20261008-r358'; reader.shadow.append(css);
+  reader.main.classList.add('archive-game');
+  const toolbar = reader.main.querySelector('.toolbar'), exit = make('a', 'hall-return', '‹');
+  exit.href = '/app/visual-novel.html'; exit.target = '_top'; exit.setAttribute('aria-label', '返回剧场大厅'); toolbar.prepend(exit);
+  const source = make('small', 'rebuild-label', '独立重建'); toolbar.querySelector('strong').after(source);
+  const assets = Array.isArray(reader.card.media_assets) ? reader.card.media_assets : [];
+  if (!assets.some(asset => asset.kind === 'background')) reader.card = { ...reader.card,
+    media_assets: [...assets, { id: 'homer-room', kind: 'background', url: '/app/assets/images/archive-room.svg', name: '教室 · 独立矢量场景' }],
+    card_experience: { ...reader.card.card_experience, galgame: { ...reader.card.card_experience?.galgame, default_background_id: 'homer-room' } } };
+  const baseShow = reader.show.bind(reader), baseButtons = reader.updateButtons.bind(reader);
+  reader.show = (...args) => { reader.main.classList.toggle('talk-mode', reader.mode === 'talk');
+    if (reader.mode !== 'talk') { reader.momoRoom?.remove(); reader.momoRoom = null; reader.talkInput = null; reader.talkSend = null; }
+    return baseShow(...args); };
+  reader.updateButtons = () => { baseButtons();
+    const blocked = session.busy || reader.busy || reader.actionPending;
+    reader.inputButton.disabled = blocked; reader.generateButton.disabled = blocked;
