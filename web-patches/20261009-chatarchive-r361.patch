+const emptyState = () => ({cloudVersion:'',ackedHash:'',pending:null,conflict:false});
+const failure = code => Object.assign(new Error(code),{code});
+function canonical(value) {
+  if(Array.isArray(value)) return '['+value.map(canonical).join(',')+']';
