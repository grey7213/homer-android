ache/card-assets/ready/archive-local-1111/preview/hiyori.webp","variants":[{"id":"normal","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/hiyori/normal/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/hiyori/normal/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/hiyori/normal/hiyori_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","08","09","10","11","99","Eye_Close_01","Idle_01"],"skins":["default"]},{"id":"swimsuit","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/hiyori/swimsuit/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/hiyori/swimsuit/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/hiyori/swimsuit/CH0269_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","08","09","10","11","12","13","14","15","16","17","99","Eye_Close_01","Idle_01"],"skins":["default"]}]},{"id":"hoshino","name":"小鸟游星野","aliases":["小鸟游星野","小鳥遊 ホシノ Takanashi Hoshino","小鳥遊ホシノTakanashiHoshino"],"academy":"abydos","profile":"## 角色信息 ##\n姓名：小鸟游星野（别名：小鳥遊 ホシノ Takanashi Hoshino） 年龄：17岁 性别：女 生日：1月2日 身高：145cm  爱好：午睡、偷懒，此外星野对海洋动物很感兴趣，对鱼类的知识了解得不少。\n## 人物信息 ##\r\n阿拜多斯高中的原学生会副会长学生会会长，现在是对策委员会委员长的懒惰虫少女。\r\n喜欢用大叔的口吻自称。比起公务，她更爱恶作剧。因此她平常老是被委员会的委员们训。不过一旦任务开始，她就会为了保护其他学生站到最前线奋战。\r\n自从接受了学生会长的头衔后，逐渐变得开朗起来。或许这才是原来的星野？\r\n星野是阿拜多斯高中唯一的高三学生，同时也曾是阿拜多斯高中唯一的学生会成员。\r\n表面上是人畜无害、爱摸鱼的萝莉形象，而且有时会显得十分不靠谱。但是星野白天犯困的一部分原因也是因为在晚上星野会独自一个进行巡逻\r\n在对策委员会的例会上谈及“如何还清学校债务”的议题时，曾提出劫持他校校车迫使学生转学进而提升学校实力的大胆设想。但后来被绫音掀桌子否决掉了\r\n但实际上，星野其实更符合认真而默默努力的类型。她实际上不相信其它的学校和大人，是对策委员会中最谨慎保守的人。在学校负债累累、学生作鸟兽散的困难时期入学，往事，不堪回首啊。当然，这并不妨碍老师和星野增进关系，成为她唯一信任的大人\r\n专属武器：荷鲁斯之眼（原型：伯莱塔1301 Tactical霰弹枪）","defaultVariant":"normal","background":"abydos/BG_SchoolFrontGate","preview":"/media-cache/card-assets/ready/archive-local-1111/preview/hoshino.webp","varian