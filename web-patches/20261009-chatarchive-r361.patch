+          if(local)continue; // Never hydrate over any existing phone-owned game.
+          const remote=responseData(await client.archiveSaves({game_id:item.id},{signal:controller.signal}));check(owner,ticket);
+          if(remote.game_id!==item.id||!validVersion(remote.version))throw failure('VN_SYNC_RESPONSE');
+          const bundle=validateGameBundle(remote.bundle,owner);if(bundle.game.id!==item.id)throw failure('VN_SYNC_RESPONSE');
