+// Data-only theme adapter. Rebuilt gameplay; user-local 1.1.11 media, NOT 1.2.6.
+const CATALOG = '/app/assets/data/chatarchive-theme.json';
+import {stageCast,installArchiveCast} from './archive-cast.mjs';
+let catalogPromise;
+export function workshopRoles(native = globalThis.window?.HomerNative) {
+  try {
+    const data = JSON.parse(native?.getArchiveWorkshopCatalog?.() || '{"roles":[]}');
+    return Array.isArray(data.roles) ? data.roles.filter(role => /^mod-[a-f0-9-]{36}-\d+$/.test(role.id)
+      && typeof role.name === 'string' && typeof role.profile === 'string' && Array.isArray(role.variants) && role.variants.length) : [];
+  } catch { return []; }
+}
+export function mergeWorkshopRoles(catalog, roles = workshopRoles()) {
+  return { ...catalog, roles: [...catalog.roles.filter(role => !role.source?.resourceId), ...roles] };
+}
+export function loadArchiveTheme(fetcher = globalThis.fetch) {
+  if (!catalogPromise) catalogPromise = fetcher(CATALOG, { cache: 'no-cache', credentials: 'same-origin' })
+    .then(async response => { if (!response.ok) throw new Error('ARCHIVE_CATALOG'); const data = await response.json();
+      if (data.version !== 1 || data.themeId !== 'kivotos-1111' || !Array.isArray(data.roles)) throw new Error('ARCHIVE_CATALOG'); return data; })
+    .catch(error => { catalogPromise = null; throw error; });
+  return catalogPromise.then(catalog => mergeWorkshopRoles(catalog));
+}
+const compact = value => String(value || '').replace(/\s/g, '').toLowerCase();
+export function archiveRole(catalog, identity) {
+  const key = compact(identity);
+  return catalog.roles.find(role => role.id === identity || compact(role.name) === key || role.aliases.some(alias => compact(alias) === key));
+}
+export function themeRoleMetadata(role) {
+  return { id: `theme:${role.id}`, appId: `theme:${role.id}`, versionId: '', name: role.name,
+    avatar: role.preview, themeRoleId: role.id, ...(role.source?.resourceId ? {mediaRef:{...role.source}} : {}) };
+}
+export function archiveCharacterCard(catalog, roleId) {
+  const role = archiveRole(catalog, roleId);
+  if (!role?.profile) throw new Error('ARCHIVE_PROFILE_MISSING');
+  if (role.source?.resourceId) return { spec: 'chara_card_v2', spec_version: '2.0', data: {
+    name: role.name, description: role.profile, personality: role.signature || '', scenario: '玩家与人物的互动故事。人物背景以提供的资料为准。',
+    first_mes: `[旁白]\n${role.name}已经来到这段故事中。`, mes_example: '', tags: ['剧情剧场'],
+    creator: 'ChatArchive 模组工坊导入', creator_notes: '人物素材由用户显式下载；游戏为独立重建。',
+    system_prompt: `扮演${role.name}，以人物资料为准，不替玩家做决定。舞台输出用[旁白]或[角色:${role.name}]标记段落。`,
+    post_history_instructions: '', alternate_greetings: [],
