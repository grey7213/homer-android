+    if (cloned.cursor != null && !cursor) throw fail('VN_STORY_INVALID', '剧情快照阅读位置无效');
+    for (const key of ['metadata', 'variables', 'extensionSettings']) {
+        if (cloned[key] !== undefined && !plain(cloned[key])) throw fail('VN_STORY_INVALID', '剧情状态必须是普通对象');
+    }
+    const checkpoint = { version: VERSION, id: checkpointId, name, messages: cloned.messages,
+        metadata: cloned.metadata ?? {}, variables: cloned.variables ?? {}, extensionSettings: cloned.extensionSettings ?? {}, cursor, createdAt };
+    const measured = safeClone(checkpoint);
+    return { checkpoint: measured.value, sizeBytes: measured.bytes };
+}
+
+function rowKey(scope, checkpointId) { return `${scope.scopeKey}:checkpoint:${JSON.stringify(checkpointId)}`; }
+
+function summaryOf(row) {
+    return { version: VERSION, id: row.id, name: row.name, createdAt: row.createdAt,
+        messageCount: row.messageCount, sizeBytes: row.sizeBytes };
+}
+
+function validateIndex(row, scope) {
+    if (!plain(row) || row.version !== VERSION || row.owner !== scope.owner || row.scopeKey !== scope.scopeKey
+        || typeof row.owner !== 'string' || typeof row.scopeKey !== 'string' || row.scopeKey.length > 1000
+        || !id(row.id, 96) || row.key !== rowKey(scope, row.id) || typeof row.name !== 'string' || !row.name.trim() || row.name.length > 160
+        || !Number.isSafeInteger(row.createdAt) || row.createdAt < 0 || !Number.isSafeInteger(row.messageCount) || row.messageCount < 0
+        || !Number.isSafeInteger(row.sizeBytes) || row.sizeBytes <= 0 || row.sizeBytes > MAX_CHECKPOINT_BYTES) {
+        throw fail('VN_STORY_CORRUPT', '已保存的剧情快照索引无效');
+    }
+    return row;
+}
+
+/** IDB transactions atomically commit complete bodies and the metadata index. */
+export function createStoryStore({ indexedDB = globalThis.indexedDB } = {}) {
+    let database = null, opening = null, closed = false;
+    function open() {
+        if (closed) return Promise.reject(fail('VN_STORY_STORE_CLOSED', '剧情快照存储已关闭'));
+        if (!indexedDB || typeof indexedDB.open !== 'function') return Promise.reject(fail('VN_STORY_STORE_UNAVAILABLE', '此环境没有持久剧情快照存储'));
+        if (database) return Promise.resolve(database);
+        if (opening) return opening;
+        opening = new Promise((resolve, reject) => {
+            let request, failed = false;
+            const rejectOpen = error => { failed = true; reject(error); };
+            try { request = indexedDB.open(DB_NAME, VERSION); }
+            catch { rejectOpen(fail('VN_STORY_STORE_UNAVAILABLE', '无法打开剧情快照存储')); return; }
+            request.onupgradeneeded = () => {
+                try {
+                    if (!request.result.objectStoreNames.contains(BODY_STORE)) request.result.createObjectStore(BODY_STORE, { keyPath: 'key' });
+                    if (!request.result.objectStoreNames.contains(INDEX_STORE)) {
+                        const store = request.result.createObjectStore(INDEX_STORE, { keyPath: 'key' });
+                        store.createIndex('scopeKey', 'scopeKey'); store.createIndex('owner', 'owner');
+                    }
+                } catch {
+                    try { request.transaction?.abort(); } catch { /* already aborted */ }
+                    rejectOpen(fail('VN_STORY_STORE_UNAVAILABLE', '无法初始化剧情快照存储'));
+                }
+            };
+            request.onerror = () => rejectOpen(fail('VN_STORY_STORE_UNAVAILABLE', '无法打开剧情快照存储'));
+            request.onblocked = () => rejectOpen(fail('VN_STORY_STORE_BLOCKED', '剧情快照存储被另一窗口占用'));
+            request.onsuccess = () => {
+                if (failed || closed) { request.result.close(); rejectOpen(fail('VN_STORY_STORE_CLOSED', '剧情快照存储已关闭')); return; }
+                database = request.result;
+                database.onversionchange = () => { database?.close(); database = null; closed = true; };
+                resolve(database);
+            };
+        }).finally(() => { opening = null; });
+        return opening;
+    }
+
+    async function transaction(scopeInput, names, mode, operation) {
+        const scope = scopeRecord(scopeInput), db = await open();
+        if (closed) throw fail('VN_STORY_STORE_CLOSED', '剧情快照存储已关闭');
+        if (names.some(name => !db.objectStoreNames?.contains(name))) throw fail('VN_STORY_STORE_UNAVAILABLE', '剧情快照数据表不可用');
+        return new Promise((resolve, reject) => {
+            let tx, result, error;
+            const abort = cause => { error = cause; try { tx.abort(); } catch { reject(error); } };
+            const guard = callback => event => { try { callback(event); } catch (cause) { abort(cause); } };
+            try {
+                try { tx = db.transaction(names, mode, mode === 'readwrite' ? { durability: 'strict' } : undefined); }
+                catch (cause) {
+                    if (cause?.name !== 'TypeError' || mode !== 'readwrite') throw cause;
+                    tx = db.transaction(names, mode);
+                }
+                tx.oncomplete = () => error ? reject(error) : resolve(result);
+                tx.onabort = () => reject(error || fail('VN_STORY_WRITE_FAILED', '剧情快照事务未完成'));
+                tx.onerror = () => { error ||= fail('VN_STORY_WRITE_FAILED', '剧情快照事务未完成'); };
