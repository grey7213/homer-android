+    if (turn.userText) messages.push({ id: `${turn.requestId}:user`, name: game.player.name,
+      is_user: true, mes: turn.userText });
+    if (turn.status === 'completed' && turn.reply) messages.push({ id: `${turn.requestId}:reply`,
+      name: active.channel === 'group' ? '故事群' : character?.name || '角色', mes: readableGameReply(turn.reply) });
+  }
+  return messages;
+}
+
