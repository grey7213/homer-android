tions":["00","01","02","03","04","05","06","07","08","09","10","11","12","13","99","Eye_Close_01","Idle_01"],"skins":["default"]}]},{"id":"serina","name":"鹫见 芹娜","aliases":["鹫见 芹娜","鹫见芹娜","鷲見 セリナ     Sumi Serina","鷲見セリナSumiSerina"],"academy":"trinity","profile":"## 角色信息 ##\n姓名：鹫见 芹娜（别名：鷲見 セリナ     Sumi Serina ） 年龄：16岁  性别：女   生日：1月6日 身高：156cm 所属：圣三一综合学园 「救护骑士团」   学年：高中2年级   喜好：在医院做志愿者\n## 人物设定 ##\n三一综合学园所属，献身于救护骑士团活动的温柔少女，负责治疗伤员，无论同学还是敌人，她都会给予治疗且不分三六九等。\n有着为志愿活动献身的善良性格，在健康方面总是有些过度担心，因而经常被周围的学生们评价为“像妈妈一样”。虽然讨厌争执，但对于威胁和平的敌人也会毅然反对。\n芹娜不仅喜欢在医院里做志愿者，更因其善良的性格使得许多孩子都会去找她（无论治疗还是送礼）。不仅如此，芹娜也会在别人遇到困难时给予帮助。在和老师对话会有一些害羞。\n芹娜是几乎每位孩子们无处不在的“天使”。作为一位能干型护士，无论是治疗伤患、住院看护还是关心老师，她都盈盈在手。相较于后辈朝颜花江“粗暴”地治疗，芹娜的治疗明显温柔许多。\n武器：Tactical Therapy（原型：L85A1 式 5.56mm 突击步枪）","defaultVariant":"normal","background":"thrinity/BG_TrinityCampus","preview":"/media-cache/card-assets/ready/archive-local-1111/preview/serina.webp","variants":[{"id":"christmas","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/christmas/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/christmas/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/christmas/CH0194_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","08","09","10","99","Eye_Close_01","Idle_01"],"skins":["default","diorama"]},{"id":"normal","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/normal/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/normal/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/normal/serina_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","99","Eye_Close_01","Idle_01"],"skins":["default"]},{"id":"nurse","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/nurse/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/nurse/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/serina/nurse/NP0075_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","99","Eye_Close_01","Idle_01"],"skins":["default"]}]},{"id":"shiroko","name":"砂狼白子","aliases":["砂狼白子","砂狼 シロコ Sunaookami Shiroko","砂狼シロコSunaookamiShiroko"],"academy":"abydos","profile":"## 角色信息 ##\n姓名：砂狼白子（别名：砂狼 シロコ Sunaookami Shiroko） 年龄：16岁 性别：女 生日：5月16日 身高：156cm  爱好：慢跑、锻炼体力、骑自行车\n## 人物信息 ##\r\n阿拜多斯高等学院（又称阿拜多斯）所属，喜欢运动的阿拜多斯对策委员会的突击队长。虽然给人沉默寡言且几乎没有表情变化的冷淡印象，但其实是个说她比任何人都珍惜阿拜多斯高中也不为过的少女。为了复兴学园会不择手段，因此偶尔会提出令人意想不到的想法。\r\n白子是个来路不明的少女，在进入阿拜多斯前始终处于流浪状态，两年前在潜入阿拜多斯学院偷东西时被星野和野宫发现，经过一番打斗后被星野制服。两人发现这个长着狼耳的小女孩处于失忆状态，对自己的过去一无所知，仅仅记得自己叫“砂狼白子”。白子从此留在了阿拜多斯学院。\r\n砂狼白子喜欢运动，是阿拜多斯废校对策委员会的突击队长。因为沉默寡言、面无表情，所以给人一种很冷漠的印象，但其实是比任何一个人都爱惜阿拜多斯的少女。为了阿拜多斯的复兴，她主张不惜一切手段，偶尔还会提出天马行空的想法。\r\n专属武器：WHITE FANG 465（原型：SG 550），除此之外白子还拥有一架战术无人机，是她偶然得到并自行修复改装的。这架无人机的动力非常强，还能发射导弹。","defaultVariant":"normal","background":"abydos/BG_SchoolFrontGate","preview":"/media-cache/card-assets/ready/archive-local-1111/preview/shiroko.webp","variants":[{"id":"bikingsuit","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/shiroko/bikingsuit/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/shiroko/bikingsuit/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/shiroko/bikingsuit/shiroko_ridingsuit_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","99","Eye_Close_01","Idle_01"],"skins":["default"]},{"id":"gymsuit","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/shiroko/gymsuit/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/shiroko/gymsuit/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/s