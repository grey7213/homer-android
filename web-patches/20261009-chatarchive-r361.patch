--- /dev/null
+++ b/frontend/app/assets/css/visual-novel-conversations.css
@@ -0,0 +1,76 @@
+.vn-conversations {
+  /* App/UI semantic tokens win; fallbacks also support an isolated mounted panel. */
+  --vh-f-bg: #f2f2f7; --vh-f-panel: #fff; --vh-f-fill: #eeeef0;
+  --vh-f-text: #1c1c1e; --vh-f-muted: #626268; --vh-f-line: #e2e2e8;
+  --vh-f-accent: #0066d6; --vh-f-tint: #e8f1ff; --vh-f-on-accent: #fff;
+  --vh-bg: var(--ui-bg, var(--app-bg, var(--vh-f-bg)));
+  --vh-panel: var(--ui-panel, var(--app-panel, var(--vh-f-panel)));
+  --vh-fill: var(--ui-panel-soft, var(--app-fill, var(--vh-f-fill)));
+  --vh-text: var(--ui-text, var(--app-text, var(--vh-f-text)));
+  --vh-muted: var(--ui-muted, var(--app-muted, var(--vh-f-muted)));
+  --vh-border: var(--ui-line, var(--app-line, var(--vh-f-line)));
+  --vh-accent: var(--ui-accent, var(--app-accent, var(--vh-f-accent)));
+  --vh-tint: var(--ui-accent-soft, var(--app-tint, var(--vh-f-tint)));
+  --vh-on-accent: var(--ui-on-accent, var(--app-on-accent, var(--vh-f-on-accent)));
+  --vh-scheme: light;
+  box-sizing: border-box; width: 100%; min-width: 0; padding: 18px;
+  color: var(--vh-text); background: var(--vh-bg); color-scheme: var(--vh-scheme);
+  font: 15px/1.55 system-ui, sans-serif;
+}
+/* layout.js updates html[data-theme]; body selectors are supported by app-design.css. */
+:where(html[data-theme="dark"], body[data-theme="dark"], body.theme-dark, body.dark) .vn-conversations {
+  --vh-f-bg: #1d2229; --vh-f-panel: #1d2229; --vh-f-fill: #292e35;
+  --vh-f-text: #edf0f4; --vh-f-muted: #b0b6c0; --vh-f-line: #363b43;
+  --vh-f-accent: #b6d7e8; --vh-f-tint: #2b353b; --vh-f-on-accent: #15242c;
+  --vh-scheme: dark;
+}
+.vn-conversations * { box-sizing: border-box; }
+.vn-conversations h2, .vn-conversations h3, .vn-conversations p { margin: 0; }
+.vn-conversations button { min-width: 44px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--vh-border); border-radius: 10px; background: var(--vh-panel); color: var(--vh-text); font: inherit; cursor: pointer; touch-action: manipulation; }
+.vn-conversations button:hover:not(:disabled) { border-color: var(--vh-accent); background: var(--vh-tint); }
+.vn-conversations button[aria-pressed="true"] { border-color: var(--vh-accent); background: var(--vh-tint); }
+.vn-conversations button:disabled { opacity: 1; cursor: not-allowed; color: var(--vh-muted) !important; background: var(--vh-fill) !important; border-color: var(--vh-border) !important; box-shadow: none; }
+.vn-conversations button:focus-visible, .vn-hub-input:focus-visible, .vn-hub-check input:focus-visible { outline: 3px solid var(--vh-accent); outline-offset: 2px; }
+.vn-hub-header, .vn-hub-tabs, .vn-hub-pager, .vn-hub-search, .vn-hub-members, .vn-hub-selected { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
+.vn-hub-header h2 { flex: 1; font-size: 20px; }
+.vn-hub-tabs { margin: 14px 0; }
+.vn-hub-layout { display: grid; grid-template-columns: minmax(220px, 32%) minmax(0, 1fr); gap: 18px; min-width: 0; }
+.vn-hub-left, .vn-hub-right { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
+.vn-hub-right { padding-left: 18px; border-left: 1px solid var(--vh-border); }
+.vn-hub-list { display: grid; gap: 8px; max-height: 62vh; overflow-y: auto; }
+.vn-hub-card { display: flex; gap: 10px; align-items: center; text-align: left; width: 100%; }
+.vn-hub-card-copy { display: grid; min-width: 0; gap: 3px; }
+.vn-hub-card-copy small { color: var(--vh-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
+.vn-hub-avatar { position: relative; display: grid; place-items: center; flex: 0 0 40px; width: 40px; height: 40px; border-radius: 12px; color: var(--vh-text); background: var(--vh-tint); overflow: hidden; }
+.vn-hub-avatar img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
+.vn-hub-input { width: 100%; min-width: 0; min-height: 44px; padding: 10px 12px; border: 1px solid var(--vh-muted); border-radius: 10px; color: var(--vh-text); -webkit-text-fill-color: var(--vh-text); background: var(--vh-panel); caret-color: var(--vh-accent); font: inherit; }
+.vn-hub-input::placeholder { color: var(--vh-muted); -webkit-text-fill-color: var(--vh-muted); opacity: 1; }
+.vn-hub-input:disabled { color: var(--vh-muted); -webkit-text-fill-color: var(--vh-muted); background: var(--vh-fill); cursor: not-allowed; }
+.vn-hub-search .vn-hub-input { flex: 1; }
+.vn-hub-primary { background: var(--vh-accent) !important; color: var(--vh-on-accent) !important; border-color: var(--vh-accent) !important; }
+.vn-hub-status, .vn-hub-hint { color: var(--vh-muted); font-size: 13px; }
+.vn-hub-warning { color: var(--vh-text); border: 1px solid var(--vh-accent); border-inline-start-width: 3px; border-radius: 10px; padding: 10px 12px; background: var(--vh-fill); font-size: 13px; margin-bottom: 10px !important; }
+.vn-hub-pager { justify-content: center; }
+.vn-hub-messages { display: flex; flex-direction: column; gap: 16px; height: min(48vh, 480px); min-height: 180px; overflow-y: auto; padding: 12px; background: var(--vh-fill); border-radius: 12px; }
+.vn-hub-message { max-width: 90%; display: grid; gap: 6px; }
+.vn-hub-message-user { align-self: flex-end; }
+.vn-hub-speaker { display: flex; align-items: center; gap: 8px; font-size: 13px; }
+.vn-hub-speaker .vn-hub-avatar { width: 28px; height: 28px; flex-basis: 28px; border-radius: 8px; }
+.vn-hub-message p { white-space: pre-wrap; overflow-wrap: anywhere; border: 1px solid var(--vh-border); border-radius: 12px; padding: 10px 12px; color: var(--vh-text); background: var(--vh-panel); }
+.vn-hub-message-user p { background: var(--vh-tint); }
+.vn-hub-cost { display: grid; gap: 6px; border: 1px solid var(--vh-border); border-radius: 10px; padding: 10px; font-size: 13px; }
+.vn-hub-check { display: flex; align-items: center; min-height: 44px; gap: 8px; cursor: pointer; touch-action: manipulation; }
+.vn-hub-check input { flex: 0 0 18px; width: 18px; height: 18px; margin: 0; accent-color: var(--vh-accent); }
+.vn-hub-composer { display: flex; gap: 8px; align-items: flex-end; }
+.vn-hub-composer textarea { resize: vertical; }
+.vn-hub-composer button { flex-shrink: 0; }
+.vn-hub-empty { padding: 35px 12px; text-align: center; color: var(--vh-muted); }
+@media (max-width: 700px) {
+  .vn-conversations { padding: 12px; }
+  .vn-hub-header h2 { flex-basis: 100%; }
+  .vn-hub-layout { grid-template-columns: minmax(0, 1fr); }
+  .vn-hub-right { padding-left: 0; padding-top: 16px; border-left: 0; border-top: 1px solid var(--vh-border); }
+  .vn-hub-list { max-height: 35vh; }
+  .vn-hub-composer { flex-wrap: wrap; }
+  .vn-hub-composer button { width: 100%; }
+}
