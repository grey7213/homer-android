学习其他学生认为没必要或者不屑于学的冷门技能，例如拆弹和组装天线。","defaultVariant":"normal","background":"srt/BG_SRTBase","preview":"/media-cache/card-assets/ready/archive-local-1111/preview/saki.webp","variants":[{"id":"gymsuit","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/gymsuit/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/gymsuit/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/gymsuit/NP0072_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","08","09","10","11","12","13","99","Eye_Close_01","Eye_Close_S2_01","Idle_01","S2_01","S2_02","S2_03","S2_04","S2_05","S2_06","S2_07","S2_08","S2_09","S2_10","S2_11","S2_12","S2_13","S2_99"],"skins":["default","Mask_01"]},{"id":"normal","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/normal/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/normal/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/normal/CH0144_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","08","09","10","11","12","13","99","Eye_Close_01","Eye_Close_S2_01","Idle_01","S2_01","S2_02","S2_03","S2_04","S2_05","S2_06","S2_07","S2_08","S2_09","S2_10","S2_11","S2_12","S2_13","S2_99"],"skins":["default","Mask_01"]},{"id":"swimsuit","atlas":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/swimsuit/main.atlas","skeleton":"/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/swimsuit/main.skel","textures":["/media-cache/card-assets/ready/archive-local-1111/media/assets/spine/saki/swimsuit/CH0217_spr.png"],"spineVersion":"4.2.33","animations":["00","01","02","03","04","05","06","07","08","09","10","11","12","13","99","Eye_Close_01","Eye_Close_S2_01","Idle_01","S2_00","S2_01","S2_02","S2_03","S2_04","S2_05","S2_0