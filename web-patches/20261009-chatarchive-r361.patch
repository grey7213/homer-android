--- /dev/null
+++ b/frontend/app/assets/js/archive-resource-client.mjs
@@ -0,0 +1,21 @@
+const failure = code => Object.assign(new Error(code), {code});
+/** Resource-only bridge. It has no account, card import or generation capability. */
+export async function prepareArchiveRole(id, {native=globalThis.window?.HomerNative, current=()=>true,
+  progress=()=>{}, delay=ms=>new Promise(resolve=>setTimeout(resolve,ms)), now=()=>Date.now(), timeout=120000}={}) {
+  const guard=()=>{if(!current())throw Object.assign(new Error('archive_scope_changed'),{name:'AbortError'});};
+  guard();
+  if (!native?.getArchiveMediaStatus || !native?.prepareArchiveMedia) throw failure('ARCHIVE_BRIDGE_REQUIRED');
+  const read=()=>{try{return JSON.parse(native.getArchiveMediaStatus());}catch{throw failure('ARCHIVE_STATUS');}};
+  const ready=data=>data.packs?.includes('full')||data.packs?.includes(id);
+  const before=read(); if (ready(before)) return true;
+  native.prepareArchiveMedia(id);
+  const start=now();
+  while(now()-start<timeout){
+    guard(); const data=read(); progress(data);
+    if(ready(data))return true;
+    if(data.requestedPack===id && Number(data.attempt)>Number(before.attempt||0) && ['download_failed','invalid','no_space','cancelled','unavailable'].includes(data.state))throw failure(data.state==='no_space'?'ARCHIVE_NO_SPACE':'ARCHIVE_DOWNLOAD_FAILED');
+    // Waits are asynchronous and bounded. Only explicit user creation requests resources.
+    await delay(250);
+  }
+  throw failure('ARCHIVE_TIMEOUT');
+}
