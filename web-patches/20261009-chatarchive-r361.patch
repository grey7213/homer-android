diff --git a/frontend/app/assets/js/archive-cast.mjs b/frontend/app/assets/js/archive-cast.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..0d301e7cb82acab75d0f537c9f04aa10e98ffb5e
--- /dev/null
+++ b/frontend/app/assets/js/archive-cast.mjs
@@ -0,0 +1,34 @@
+/** Explicit joined cast only. No invented characters or automatic model requests. */
+export function stageCast(game, speaker) {
+  const members=(game?.characters||[]).filter(row=>row.themeRoleId);
+  const active=members.find(row=>row.id===game.active?.characterId);
+  if(game?.active?.eventId)return active?[active]:[];
+  const spoken=members.find(row=>row.name===speaker);
+  return [...new Map([spoken,active,...members].filter(Boolean).map(row=>[row.id,row])).values()].slice(0,3);
+}
+
+export function installArchiveCast(reader) {
+  let epoch=0;
+  const slots=new Map();
+  reader.disposeArchiveCast=()=>{++epoch;for(const item of slots.values()){item.layer.dispose();item.node.remove();}slots.clear();reader.stage.classList.remove('archive-ensemble');};
+  reader.applyArchiveCast=async(scene,token)=>{
+    const request=++epoch;
+    const valid=()=>request===epoch&&reader.presentationActive()&&reader.mode==='stage'&&token===reader.mediaEpoch;
+    const cast=(scene?.cast||[]).filter(row=>row?.kind==='spine');
+    const primary=scene?.portrait?.id?.split('/')[0];
+    const supporting=cast.filter(row=>row.id.split('/')[0]!==primary).slice(0,2);
+    const wanted=new Set(supporting.map(row=>row.id.split('/')[0]));
+    for(const [id,item] of slots)if(!wanted.has(id)){item.layer.dispose();item.node.remove();slots.delete(id);}
+    reader.stage.classList.toggle('archive-ensemble',supporting.length>0);
+    if(!supporting.length)return;
+    const {SpinePortraitLayer}=await import('./spine-portrait.mjs');if(!valid())return;
+    await Promise.all(supporting.map(async(asset,index)=>{
+      const id=asset.id.split('/')[0];let item=slots.get(id);
+      if(!item){const node=document.createElement('div');node.className='archive-supporting-actor';node.setAttribute('aria-hidden','true');reader.stage.append(node);item={node,layer:new SpinePortraitLayer(node)};slots.set(id,item);}
+      item.request=request;
+      item.node.dataset.position=String(index);
+      await item.layer.show(asset);
+      if(!valid()&&slots.get(id)===item&&item.request===request){item.layer.dispose();item.node.remove();slots.delete(id);}
+    }));
+  };
+}
diff --git a/frontend/app/assets/js/archive-game-ui.mjs b/frontend/app/assets/js/archive-game-ui.mjs
