+    return {
+        async save(scope, input) {
+            // Capture a full defensive copy before waiting for database work.
+            scopeRecord(scope);
+            const { checkpoint, sizeBytes } = checkpointFrom(input);
+            return transaction(scope, [BODY_STORE, INDEX_STORE], 'readwrite', ({ scope, tx, guard, setResult }) => {
+                const key = rowKey(scope, checkpoint.id), index = tx.objectStore(INDEX_STORE);
+                let ownerBytes = 0, scopeCount = 0, previous = null;
+                const cursor = index.index('owner').openCursor(scope.owner);
+                cursor.onsuccess = guard(() => {
+                    const entry = cursor.result;
+                    if (entry) {
+                        const raw = entry.value;
+                        const row = validateIndex(raw, { owner: scope.owner, scopeKey: raw.scopeKey });
+                        ownerBytes += row.sizeBytes;
+                        if (row.scopeKey === scope.scopeKey) { scopeCount++; if (row.key === key) previous = row; }
+                        if (ownerBytes > MAX_OWNER_BYTES) throw fail('VN_STORY_CORRUPT', '剧情快照容量索引无效');
+                        entry.continue(); return;
+                    }
+                    if (!previous && scopeCount >= MAX_SLOTS) throw fail('VN_STORY_LIMIT', '当前故事最多保存 24 个完整剧情快照');
+                    if (ownerBytes - (previous?.sizeBytes || 0) + sizeBytes > MAX_OWNER_BYTES) throw fail('VN_STORY_OWNER_BUDGET', '此账号的剧情快照已达到 256 MiB 上限');
+                    const row = { key, version: VERSION, owner: scope.owner, scopeKey: scope.scopeKey,
+                        id: checkpoint.id, name: checkpoint.name, createdAt: checkpoint.createdAt,
+                        messageCount: checkpoint.messages.length, sizeBytes };
+                    tx.objectStore(BODY_STORE).put({ key, version: VERSION, owner: scope.owner, scopeKey: scope.scopeKey, checkpoint });
+                    index.put(row);
+                    setResult(summaryOf(row));
+                });
+            });
+        },
+        list(scope) {
+            return transaction(scope, [INDEX_STORE], 'readonly', ({ scope, tx, guard, setResult }) => {
+                const rows = [], cursor = tx.objectStore(INDEX_STORE).index('scopeKey').openCursor(scope.scopeKey);
+                cursor.onsuccess = guard(() => {
+                    const entry = cursor.result;
+                    if (entry) {
+                        rows.push(summaryOf(validateIndex(entry.value, scope)));
+                        if (rows.length > MAX_SLOTS) throw fail('VN_STORY_CORRUPT', '剧情快照数量索引无效');
+                        entry.continue();
+                    } else setResult(rows.sort((a, b) => b.createdAt - a.createdAt || a.id.localeCompare(b.id)));
+                });
+            });
+        },
+        get(scope, checkpointId) {
+            return transaction(scope, [BODY_STORE], 'readonly', ({ scope, tx, guard, setResult }) => {
+                const selectedId = id(checkpointId, 96);
+                if (!selectedId) throw fail('VN_STORY_INVALID', '剧情快照编号无效');
+                const key = rowKey(scope, selectedId), request = tx.objectStore(BODY_STORE).get(key);
+                request.onsuccess = guard(() => {
+                    const row = request.result;
+                    if (row === undefined) { setResult(null); return; }
+                    if (!plain(row) || row.key !== key || row.version !== VERSION || row.owner !== scope.owner || row.scopeKey !== scope.scopeKey) {
+                        throw fail('VN_STORY_CORRUPT', '已保存的剧情快照范围无效');
+                    }
+                    const { checkpoint, sizeBytes } = checkpointFrom(row.checkpoint);
+                    if (checkpoint.id !== selectedId) throw fail('VN_STORY_CORRUPT', '已保存的剧情快照编号无效');
+                    setResult({ ...checkpoint, messageCount: checkpoint.messages.length, sizeBytes });
+                });
+            });
+        },
+        delete(scope, checkpointId) {
+            return transaction(scope, [BODY_STORE, INDEX_STORE], 'readwrite', ({ scope, tx, guard, setResult }) => {
+                const selectedId = id(checkpointId, 96);
+                if (!selectedId) throw fail('VN_STORY_INVALID', '剧情快照编号无效');
+                const key = rowKey(scope, selectedId), index = tx.objectStore(INDEX_STORE), request = index.get(key);
+                request.onsuccess = guard(() => {
+                    if (request.result === undefined) { setResult(false); return; }
+                    validateIndex(request.result, scope);
+                    tx.objectStore(BODY_STORE).delete(key); index.delete(key); setResult(true);
+                });
+            });
+        },
+        close() { closed = true; database?.close(); database = null; },
+    };
+}
