+def checked_regex_replacement(value: object) -> str:
+    text = str(value if value is not None else "")
+    if len(text.encode("utf-8")) > REGEX_REPLACE_MAX_BYTES:
+        raise ValueError("界面模板（正则）单条替换内容不能超过 8 MiB；未保存，请缩小文件后重试")
+    return text
